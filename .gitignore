# 密钥与本地配置
backend/.env
# 向量库数据
backend/data/chroma/
# 运行时数据库（本地生成，不入库）
backend/data/*.db
# 用户上传的图片（运行时生成，不入库）
backend/data/uploads/
# 校徽缓存（记的是 uploads/ 下的路径，那也是运行时生成的）
backend/data/school_logo_cache.json
backend/data/school_logo_failed.json
# 整理高校名单时下载的第三方原始数据（scripts/build_university_list.py 可重新生成）
backend/_data_tmp/
# 导出的材料文档（运行时生成，不入库）
backend/data/exports/
# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
# 小程序
miniprogram/node_modules/
# 系统
.DS_Store
Thumbs.db

# mermaid 渲染中间产物
docs/node_modules/
docs/package*.json
docs/puppeteer-config.json
