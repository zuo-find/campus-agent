page { background: #f5f6f8; }
.container { display: flex; flex-direction: column; min-height: 100vh; box-sizing: border-box; }
.btn-primary {
  background: #1a73e8; color: #fff; border-radius: 12rpx;
  font-size: 30rpx; padding: 20rpx 0;
}
.card {
  background: #fff; border-radius: 16rpx; padding: 28rpx;
  margin: 20rpx 24rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
