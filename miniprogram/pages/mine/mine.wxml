<view class="page">
  <!-- 渐变头部 -->
  <view class="hero">
    <view class="brand">
      <view class="brand-logo">🎓</view>
      <text class="brand-name">校园助手</text>
      <text class="brand-slogan">你的校园 AI 伙伴</text>
    </view>
  </view>

  <!-- 未登录：登录卡片 -->
  <view wx:if="{{!logged}}" class="login-card">
    <view class="avatar-ph"></view>
    <text class="login-title">登录校园助手</text>
    <text class="login-sub">同步成绩 · DDL · 让 AI 更懂你</text>

    <button class="wx-btn" bindtap="wxLogin" disabled="{{logging}}">
      <view class="wx-logo">
        <view class="bub bub-a"></view>
        <view class="bub bub-b"></view>
        <view class="tail tail-a"></view>
        <view class="tail tail-b"></view>
      </view>
      <text>{{logging ? '正在登录…' : '微信一键登录'}}</text>
    </button>

    <view class="agree" bindtap="toggleAgree">
      <view class="cb {{agreed ? 'on' : ''}}">{{agreed ? '✓' : ''}}</view>
      <text class="agree-txt">我已阅读并同意
        <text class="link" catchtap="openDoc" data-type="用户协议">《用户协议》</text>和
        <text class="link" catchtap="openDoc" data-type="隐私政策">《隐私政策》</text>
      </text>
    </view>
  </view>

  <!-- 已登录：个人卡片 -->
  <block wx:else>
    <view class="me-card">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{user.avatar}}" class="avatar" src="{{user.avatar}}" mode="aspectFill" />
        <view wx:else class="avatar-ph small"></view>
        <view class="cam">📷</view>
      </button>
      <input class="nick" type="nickname" value="{{user.nickname}}" placeholder="点击设置昵称"
             bindblur="onNickBlur" />
      <view class="uid">ID {{shortId}}</view>
    </view>

    <view class="card menu">
      <view class="menu-item" bindtap="goScores"><text class="mi-ico">📊</text><text class="mi-txt">我的成绩</text><text class="arrow">›</text></view>
      <view class="menu-item" bindtap="goDdl"><text class="mi-ico">⏰</text><text class="mi-txt">我的 DDL</text><text class="arrow">›</text></view>
    </view>

    <view class="card menu">
      <view class="menu-item danger" bindtap="logout"><text class="mi-ico">🚪</text><text class="mi-txt">退出登录</text><text class="arrow">›</text></view>
    </view>
  </block>

  <!-- 未登录：功能说明 -->
  <view wx:if="{{!logged}}" class="card feats">
    <view class="feat"><text class="feat-ico">📊</text><view><text class="feat-t">成绩与 DDL 同步</text><text class="feat-d">换手机也不丢数据</text></view></view>
    <view class="feat"><text class="feat-ico">🤖</text><view><text class="feat-t">AI 更懂你</text><text class="feat-d">记住你的偏好与课表</text></view></view>
    <view class="feat"><text class="feat-ico">📦</text><view><text class="feat-t">失物招领归属</text><text class="feat-d">发布记录绑定到你的账号</text></view></view>
  </view>

  <view class="foot">校园服务智能体 · 参赛作品</view>
</view>
