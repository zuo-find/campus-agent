<view class="page">
  <!-- 渐变头部 -->
  <view class="hero">
    <view class="brand">
      <view class="brand-logo">
        <image class="brand-logo-img" src="/images/logo.png" mode="aspectFit" />
      </view>
      <text class="brand-name">校园助手</text>
      <text class="brand-slogan">你的校园 AI 伙伴</text>
    </view>
  </view>

  <!-- 未登录：登录卡片 -->
  <view wx:if="{{!logged}}" class="login-card">
    <view class="avatar-tap" bindtap="tapAvatar">
      <view class="avatar-ph"></view>
    </view>
    <text class="login-title">登录校园助手</text>
    <text class="login-sub">点上方头像，或下方按钮登录</text>

    <button class="wx-btn" bindtap="wxLogin" disabled="{{logging}}">
      <view class="wx-logo">
        <view class="bub bub-a"></view>
        <view class="bub bub-b"></view>
        <view class="tail tail-a"></view>
        <view class="tail tail-b"></view>
      </view>
      <text>{{logging ? '正在登录…' : '微信一键登录'}}</text>
    </button>

    <view class="agree" bindtap="toggleAgree">
      <view class="cb {{agreed ? 'on' : ''}}">{{agreed ? '✓' : ''}}</view>
      <text class="agree-txt">我已阅读并同意
        <text class="link" catchtap="openDoc" data-type="用户协议">《用户协议》</text>和
        <text class="link" catchtap="openDoc" data-type="隐私政策">《隐私政策》</text>
      </text>
    </view>
  </view>

  <!-- 已登录：个人卡片 -->
  <block wx:else>
    <view class="me-card">
      <view class="ok-banner {{justLogged ? 'show' : ''}}">✓ 登录成功</view>
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{user.avatar}}" class="avatar" src="{{user.avatar}}" mode="aspectFill" />
        <view wx:else class="avatar-ph small"></view>
      </button>
      <view class="avatar-hint" wx:if="{{profileHint}}" bindtap="onHintTap">{{profileHint}} ›</view>
      <input id="nick" class="nick" type="nickname" value="{{user.nickname}}" placeholder="点击设置昵称"
             focus="{{nickFocus}}" bindblur="onNickBlur" bindconfirm="onNickBlur" />
      <view class="uid">ID {{shortId}}</view>
    </view>
  </block>

  <!-- 数据概览 -->
  <view class="card stat-card">
    <view class="st" bindtap="goScores">
      <text class="st-n">{{stat.courses}}</text><text class="st-l">已录课程</text>
    </view>
    <view class="st" data-tab="market" bindtap="goLife">
      <text class="st-n">{{stat.market}}</text><text class="st-l">我的闲置</text>
    </view>
    <view class="st" data-tab="lost" bindtap="goLife">
      <text class="st-n">{{stat.lost}}</text><text class="st-l">我的失物</text>
    </view>
    <view class="st" bindtap="openDocs">
      <text class="st-n">{{stat.doc}}</text><text class="st-l">生成材料</text>
    </view>
  </view>

  <!-- 我的内容 -->
  <view class="grp">
    <view class="grp-t">我的内容</view>
    <view class="card menu">
      <view class="menu-item" bindtap="goScores">
        <view class="mi-dot d0"></view><text class="mi-txt">我的成绩</text><text class="arrow">›</text>
      </view>
      <view class="menu-item" data-tab="market" bindtap="goLife">
        <view class="mi-dot d1"></view><text class="mi-txt">我发布的闲置</text><text class="arrow">›</text>
      </view>
      <view class="menu-item" data-tab="lost" bindtap="goLife">
        <view class="mi-dot d2"></view><text class="mi-txt">我的失物招领</text><text class="arrow">›</text>
      </view>
      <view class="menu-item" bindtap="openDocs">
        <view class="mi-dot d3"></view><text class="mi-txt">我生成的材料</text>
        <text class="mi-badge">{{stat.doc}}</text><text class="arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 设置 -->
  <view class="grp">
    <view class="grp-t">设置</view>
    <view class="card menu">
      <view class="menu-item" bindtap="goModel">
        <view class="mi-dot d0"></view><text class="mi-txt">大模型设置</text><text class="arrow">›</text>
      </view>
      <view class="menu-item" bindtap="openServer">
        <view class="mi-dot d1"></view><text class="mi-txt">服务器地址</text>
        <text class="mi-badge srv">{{apiShort}}</text><text class="arrow">›</text>
      </view>
      <view class="menu-item" bindtap="clearLocal">
        <view class="mi-dot d4"></view><text class="mi-txt">清除本地数据</text><text class="arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 帮助与关于 -->
  <view class="grp">
    <view class="grp-t">帮助与关于</view>
    <view class="card menu">
      <view class="menu-item" bindtap="openHelp">
        <view class="mi-dot d1"></view><text class="mi-txt">使用帮助</text><text class="arrow">›</text>
      </view>
      <view class="menu-item" bindtap="openFeedback">
        <view class="mi-dot d2"></view><text class="mi-txt">意见反馈</text><text class="arrow">›</text>
      </view>
      <view class="menu-item" bindtap="openAbout">
        <view class="mi-dot d3"></view><text class="mi-txt">关于本作品</text><text class="arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="card menu" wx:if="{{logged}}">
    <view class="menu-item danger" bindtap="logout"><text class="mi-txt">退出登录</text><text class="arrow">›</text></view>
  </view>

  <!-- 协议入口 -->
  <view class="links">
    <text class="link-item" bindtap="goAgreement" data-type="service">服务协议</text>
    <text class="link-sep">·</text>
    <text class="link-item" bindtap="goAgreement" data-type="privacy">隐私政策</text>
  </view>
  <view class="foot">校园服务智能体 · 参赛作品</view>

  <!-- 服务器地址 -->
  <view wx:if="{{srvShow}}" class="mask" bindtap="closeServer">
    <view class="sheet" catchtap="noop">
      <view class="sheet-h">服务器地址<text class="sheet-x" catchtap="closeServer">✕</text></view>
      <view class="srv-tip">开发者工具里用默认的 127.0.0.1 就行。手机 / 体验版要填电脑的局域网 IP，例如 http://192.168.1.5:8000（启动后端时会打印这个地址），并且手机要和电脑连同一个 WiFi。</view>
      <input class="f-input full" placeholder="http://192.168.1.5:8000" value="{{srvUrl}}" bindinput="onSrvUrl" />
      <view class="srv-btns">
        <view class="srv-test" bindtap="testServer">{{srvTesting ? '测试中…' : '测试连接'}}</view>
      </view>
      <view wx:if="{{srvMsg}}" class="srv-msg {{srvOk ? 'ok' : ''}}">{{srvMsg}}</view>
      <button class="btn-primary" bindtap="saveServer">保存</button>
      <view class="srv-note">留空保存 = 恢复默认的 127.0.0.1:8000</view>
    </view>
  </view>

  <!-- 我生成的材料 -->
  <view wx:if="{{docShow}}" class="mask" bindtap="closeDocs">
    <view class="sheet" catchtap="noop">
      <view class="sheet-h">我生成的材料<text class="sheet-x" catchtap="closeDocs">✕</text></view>
      <scroll-view class="sheet-body" scroll-y>
        <block wx:if="{{docs.length}}">
          <view class="d-item" wx:for="{{docs}}" wx:key="at">
            <view class="d-main">
              <text class="d-t">{{item.title}}</text>
              <text class="d-s">{{item.docType}}</text>
            </view>
            <text class="d-copy" data-title="{{item.title}}" catchtap="copyDoc">复制标题</text>
          </view>
          <view class="d-tip">材料正文可在问答页重新生成；这里只记录你生成过哪些。</view>
        </block>
        <view wx:else class="d-empty">还没有生成过材料。去问答页试试「帮我写一份请假条：感冒发烧请2天」。</view>
      </scroll-view>
    </view>
  </view>
</view>
