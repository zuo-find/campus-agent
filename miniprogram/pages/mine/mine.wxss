.page { min-height: 100vh; background: #f2f4f8; padding-bottom: 60rpx; }

/* ---------- 渐变头部 ---------- */
.hero {
  height: 460rpx;
  background: linear-gradient(160deg, #2b7cf0 0%, #1a73e8 45%, #4a9bff 100%);
  border-radius: 0 0 48rpx 48rpx;
  display: flex; align-items: flex-start; justify-content: center;
  padding-top: 96rpx; box-sizing: border-box;
}
.brand { display: flex; flex-direction: column; align-items: center; }
.brand-logo {
  width: 108rpx; height: 108rpx; border-radius: 30rpx;
  background: rgba(255,255,255,.22);
  display: flex; align-items: center; justify-content: center;
  font-size: 56rpx; margin-bottom: 22rpx;
}
.brand-name { color: #fff; font-size: 40rpx; font-weight: 600; letter-spacing: 2rpx; }
.brand-slogan { color: rgba(255,255,255,.8); font-size: 24rpx; margin-top: 10rpx; }

/* ---------- 登录卡片 ---------- */
.login-card {
  background: #fff; border-radius: 24rpx; margin: -80rpx 40rpx 0;
  padding: 56rpx 44rpx 40rpx; position: relative; z-index: 2;
  box-shadow: 0 12rpx 40rpx rgba(26,115,232,.12);
  display: flex; flex-direction: column; align-items: center;
}
.login-title { font-size: 36rpx; font-weight: 600; color: #1a2b45; margin-top: 30rpx; }
.login-sub { font-size: 25rpx; color: #93a1b5; margin-top: 14rpx; margin-bottom: 44rpx; }

.wx-btn {
  width: 100%; display: flex; align-items: center; justify-content: center;
  background: #07c160; color: #fff; border-radius: 48rpx;
  font-size: 31rpx; line-height: 92rpx; padding: 0; margin: 0;
  box-shadow: 0 8rpx 20rpx rgba(7,193,96,.28);
}
.wx-btn[disabled] { background: #8fd9b3; box-shadow: none; }
.wx-btn::after { border: none; }

/* 微信 Logo：两个白色气泡 + 尾巴（纯 CSS，不依赖图片） */
.wx-logo { position: relative; width: 56rpx; height: 44rpx; margin-right: 18rpx; }
.bub { position: absolute; background: #fff; border-radius: 50%; }
.bub-a { width: 36rpx; height: 30rpx; top: 0; left: 0; }
.bub-b { width: 28rpx; height: 23rpx; bottom: 0; right: 0; }
.tail { position: absolute; width: 0; height: 0;
  border-left: 7rpx solid transparent; border-right: 7rpx solid transparent;
  border-top: 9rpx solid #fff; }
.tail-a { bottom: -5rpx; left: 9rpx; }
.tail-b { bottom: -2rpx; right: 7rpx; }
/* 气泡里的小点：用绿色小圆（在绿底上表现为镂空） */
.bub-a::after { content: ''; position: absolute; width: 7rpx; height: 7rpx; border-radius: 50%;
  background: #07c160; top: 10rpx; left: 7rpx; box-shadow: 11rpx 0 0 #07c160; }
.bub-b::after { content: ''; position: absolute; width: 6rpx; height: 6rpx; border-radius: 50%;
  background: #07c160; top: 8rpx; left: 6rpx; box-shadow: 9rpx 0 0 #07c160; }

/* 协议勾选 */
.agree { display: flex; align-items: flex-start; margin-top: 34rpx; padding: 0 4rpx; }
.cb {
  width: 32rpx; height: 32rpx; border-radius: 50%; border: 2rpx solid #c6d0de;
  margin-right: 14rpx; flex-shrink: 0; box-sizing: border-box;
  display: flex; align-items: center; justify-content: center;
  font-size: 20rpx; color: #fff; transition: all .15s;
}
.cb.on { background: #1a73e8; border-color: #1a73e8; }
.agree-txt { font-size: 23rpx; color: #8a97a8; line-height: 1.5; }
.link { color: #1a73e8; }

/* ---------- 默认头像（CSS 绘制：头 + 肩） ---------- */
.avatar-ph {
  position: relative; width: 150rpx; height: 150rpx; border-radius: 50%;
  background: linear-gradient(160deg, #dbe7ff, #c2d6ff);
  overflow: hidden; flex-shrink: 0;
}
.avatar-ph::before {
  content: ''; position: absolute; top: 30rpx; left: 50%; transform: translateX(-50%);
  width: 50rpx; height: 50rpx; border-radius: 50%; background: #8fb3f0;
}
.avatar-ph::after {
  content: ''; position: absolute; bottom: -26rpx; left: 50%; transform: translateX(-50%);
  width: 104rpx; height: 76rpx; border-radius: 52rpx 52rpx 0 0; background: #8fb3f0;
}
.avatar-ph.small { width: 140rpx; height: 140rpx; }

/* ---------- 已登录 个人卡片 ---------- */
.me-card {
  background: #fff; border-radius: 24rpx; margin: -80rpx 40rpx 20rpx;
  padding: 44rpx; position: relative; z-index: 2;
  box-shadow: 0 12rpx 40rpx rgba(26,115,232,.12);
  display: flex; flex-direction: column; align-items: center;
}
.avatar-btn { padding: 0; margin: 0; background: transparent; line-height: 0; border: none; position: relative; }
.avatar-btn::after { border: none; }
.avatar { width: 140rpx; height: 140rpx; border-radius: 50%; background: #eaf1fe; }
.avatar-tap { padding: 8rpx; border-radius: 50%; transition: background .15s; }
.avatar-tap:active { background: #eef4fe; }
.avatar-hint { font-size: 22rpx; color: #1a73e8; margin-top: 16rpx; }

/* 登录成功横幅（浮在卡片顶部、头像上方） */
.ok-banner {
  position: absolute; left: 50%; top: 0;
  transform: translate(-50%, -50%) scale(.9);
  background: #0f9d63; color: #fff; font-size: 24rpx; font-weight: 500;
  padding: 12rpx 32rpx; border-radius: 32rpx; white-space: nowrap;
  box-shadow: 0 10rpx 24rpx rgba(15,157,99,.32);
  opacity: 0; pointer-events: none;
  transition: all .3s cubic-bezier(.2,.8,.3,1);
  z-index: 5;
}
.ok-banner.show { opacity: 1; transform: translate(-50%, -50%) scale(1); }
.nick { font-size: 36rpx; font-weight: 600; color: #1a2b45; text-align: center; margin-top: 26rpx; width: 70%; }
.uid { font-size: 22rpx; color: #b6c0cf; margin-top: 10rpx; }

/* ---------- 菜单 ---------- */
.card { background: #fff; border-radius: 20rpx; margin: 20rpx 40rpx; box-shadow: 0 4rpx 18rpx rgba(0,0,0,.03); }
.menu { padding: 0 32rpx; }
.menu-item { display: flex; align-items: center; padding: 32rpx 0; border-bottom: 1rpx solid #f2f4f8; }
.menu-item:last-child { border-bottom: none; }
.mi-ico { font-size: 34rpx; margin-right: 20rpx; }
.mi-txt { flex: 1; font-size: 30rpx; color: #24324a; }
.menu-item.danger .mi-txt { color: #e5484d; }
.arrow { color: #c6d0de; font-size: 40rpx; }

/* ---------- 功能说明 ---------- */
.feats { padding: 16rpx 32rpx; }
.feat { display: flex; align-items: center; padding: 24rpx 0; }
.feat-dot { width: 18rpx; height: 18rpx; border-radius: 50%; margin-right: 26rpx; flex-shrink: 0; }
.feat-dot.d0 { background: #1a73e8; }
.feat-dot.d1 { background: #ff8a00; }
.feat-dot.d2 { background: #10b981; }
.feat-t { display: block; font-size: 29rpx; color: #24324a; }
.feat-d { display: block; font-size: 23rpx; color: #93a1b5; margin-top: 6rpx; }

.links { display: flex; align-items: center; justify-content: center; margin-top: 50rpx; }
.link-item { font-size: 25rpx; color: #1a73e8; padding: 8rpx 20rpx; }
.link-sep { font-size: 22rpx; color: #c6d0de; }

.foot { text-align: center; font-size: 22rpx; color: #b6c0cf; margin-top: 18rpx; }

/* ---------- 数据概览 ---------- */
.stat-card { display: flex; padding: 24rpx 8rpx; }
.st { flex: 1; display: flex; flex-direction: column; align-items: center; }
.st:active { opacity: .6; }
.st-n { font-size: 40rpx; font-weight: 700; color: #1a73e8; }
.st-l { font-size: 22rpx; color: #8c98ab; margin-top: 8rpx; }

/* ---------- 分组 ---------- */
.grp { margin-top: 26rpx; }
.grp-t { font-size: 24rpx; color: #9aa6b5; margin: 0 40rpx 10rpx; }
.grp .card { margin-top: 0; }
.mi-dot { width: 14rpx; height: 14rpx; border-radius: 50%; margin-right: 22rpx; flex-shrink: 0; }
.mi-dot.d0 { background: #1a73e8; }
.mi-dot.d1 { background: #ff8a00; }
.mi-dot.d2 { background: #10b981; }
.mi-dot.d3 { background: #7c3aed; }
.mi-dot.d4 { background: #e5484d; }
.mi-badge {
  font-size: 22rpx; color: #1a73e8; background: #eaf1fe; border-radius: 20rpx;
  padding: 2rpx 16rpx; margin-right: 12rpx;
}

/* ---------- 我生成的材料 ---------- */
.mask { position: fixed; inset: 0; background: rgba(16,24,40,.5); z-index: 60; display: flex; align-items: flex-end; }
.sheet { width: 100%; background: #fff; border-radius: 28rpx 28rpx 0 0; padding: 28rpx 32rpx 40rpx; box-sizing: border-box; }
.sheet-h { position: relative; text-align: center; font-size: 32rpx; font-weight: 600; color: #1a2233; padding-bottom: 20rpx; }
.sheet-x { position: absolute; right: 0; top: 0; font-size: 30rpx; color: #a6b0c0; padding: 0 8rpx; }
.sheet-body { max-height: 820rpx; }
.d-item { display: flex; align-items: center; padding: 22rpx 0; border-bottom: 1rpx solid #f2f4f8; }
.d-main { flex: 1; min-width: 0; }
.d-t { display: block; font-size: 29rpx; color: #1a2233; }
.d-s { display: block; font-size: 22rpx; color: #9aa6b5; margin-top: 6rpx; }
.d-copy { font-size: 24rpx; color: #1a73e8; border: 1rpx solid #cfe0fb; border-radius: 26rpx; padding: 8rpx 22rpx; }
.d-tip { font-size: 22rpx; color: #a6b0c0; margin-top: 22rpx; line-height: 1.6; }
.d-empty { font-size: 25rpx; color: #9aa6b5; line-height: 1.7; padding: 20rpx 0; }

/* ---------- 服务器地址 ---------- */
.mi-badge.srv { color: #5a6684; background: #f0f3f8; font-size: 21rpx; max-width: 320rpx;
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.srv-tip { font-size: 23rpx; color: #8c98ab; line-height: 1.75; margin-bottom: 18rpx; }
.f-input.full { width: 100%; box-sizing: border-box; background: #f2f5fa; border-radius: 10rpx;
  padding: 20rpx 22rpx; font-size: 27rpx; color: #1a2233; }
.srv-btns { display: flex; margin-top: 16rpx; }
.srv-test { font-size: 25rpx; color: #1a73e8; border: 1rpx solid #cfe0fb; border-radius: 30rpx;
  padding: 10rpx 28rpx; }
.srv-test:active { background: #eaf1fe; }
.srv-msg { font-size: 23rpx; color: #b42318; background: #fff2f2; border-radius: 10rpx;
  padding: 14rpx 18rpx; margin-top: 16rpx; line-height: 1.6; }
.srv-msg.ok { color: #0f5132; background: #e7f7ef; }
.srv-note { font-size: 22rpx; color: #b6c0cf; text-align: center; margin-top: 16rpx; }
