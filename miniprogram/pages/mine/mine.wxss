.container { padding-bottom: 40rpx; }

.header { display: flex; flex-direction: column; align-items: center; padding: 70rpx 40rpx 50rpx; background: #fff; }
.header.on { }
.avatar { width: 140rpx; height: 140rpx; border-radius: 50%; background: #eaf1fe; }
.avatar-btn { padding: 0; margin: 0; background: transparent; line-height: 1; border: none; }
.avatar-btn::after { border: none; }

.login-tip { font-size: 26rpx; color: #999; margin: 24rpx 0 32rpx; }
.login-btn { display: flex; align-items: center; justify-content: center; background: #1a73e8; color: #fff; border-radius: 44rpx; font-size: 30rpx; padding: 0 60rpx; line-height: 88rpx; }
.login-btn[disabled] { background: #a9c4f5; }
.wx-icon { display: inline-block; width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center; background: #fff; color: #1a73e8; border-radius: 50%; font-size: 24rpx; margin-right: 14rpx; }

.nick-input { font-size: 36rpx; font-weight: 600; color: #222; text-align: center; margin-top: 24rpx; width: 60%; }
.openid { font-size: 22rpx; color: #bbb; margin-top: 12rpx; }

.card { background: #fff; border-radius: 16rpx; margin: 20rpx 24rpx; padding: 8rpx 28rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,.04); }
.menu { padding: 0 28rpx; }
.menu-item { display: flex; justify-content: space-between; align-items: center; padding: 30rpx 0; font-size: 30rpx; color: #333; border-bottom: 1rpx solid #f2f2f2; }
.menu-item:last-child { border-bottom: none; }
.menu-item.danger { color: #e53935; }
.arrow { color: #ccc; font-size: 40rpx; }

.sec-title { font-size: 28rpx; font-weight: 600; margin: 20rpx 0 16rpx; color: #222; }
.feat { font-size: 27rpx; color: #666; padding: 12rpx 0; }
.tip { font-size: 24rpx; color: #aaa; text-align: center; margin: 30rpx 40rpx; line-height: 1.6; }
