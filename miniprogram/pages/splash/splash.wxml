<view class="splash {{go ? 'go' : ''}} {{leaving ? 'leave' : ''}}" bindtap="skip">
  <!-- 背景光晕 -->
  <view class="glow glow-1"></view>
  <view class="glow glow-2"></view>

  <view class="center">
    <!-- logo：白色圆角底座 + 应用图标 -->
    <view class="logo">
      <image class="logo-img" src="/images/logo.png" mode="aspectFit" />
    </view>

    <text class="title">校园助手</text>
    <text class="slogan">你的校园 AI 伙伴</text>

    <!-- 四个能力圆点依次点亮 -->
    <view class="dots">
      <view class="dot d0"></view>
      <view class="dot d1"></view>
      <view class="dot d2"></view>
      <view class="dot d3"></view>
    </view>
  </view>

  <view class="foot">
    <text class="foot-t">校园服务智能体 · 参赛作品</text>
  </view>

  <view class="skip-hint">轻触跳过</view>
</view>
