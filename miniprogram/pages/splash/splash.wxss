page { height: 100%; }

.splash {
  position: fixed; inset: 0;
  background: linear-gradient(160deg, #1f6fe8 0%, #1a73e8 45%, #3f93ff 100%);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  overflow: hidden;
  opacity: 1; transition: opacity .4s ease;
}
.splash.leave { opacity: 0; }

/* 背景光晕 */
.glow { position: absolute; border-radius: 50%; filter: blur(60rpx); opacity: 0; transition: opacity 1.2s ease; }
.glow-1 { width: 520rpx; height: 520rpx; background: rgba(255,255,255,.22); top: -120rpx; right: -120rpx; }
.glow-2 { width: 460rpx; height: 460rpx; background: rgba(120,180,255,.35); bottom: -100rpx; left: -140rpx; }
.splash.go .glow-1 { opacity: 1; }
.splash.go .glow-2 { opacity: 1; }

.center { display: flex; flex-direction: column; align-items: center; z-index: 2; }

/* logo 方块 */
.logo {
  width: 160rpx; height: 160rpx; border-radius: 44rpx;
  background: rgba(255,255,255,.18); border: 2rpx solid rgba(255,255,255,.3);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,.18);
  opacity: 0; transform: translateY(40rpx) scale(.8);
  transition: opacity .6s ease, transform .6s cubic-bezier(.2,.9,.3,1.2);
}
.splash.go .logo { opacity: 1; transform: translateY(0) scale(1); }

/* 学士帽（纯 CSS） */
.cap { position: relative; width: 92rpx; height: 70rpx; }
.cap-top {
  position: absolute; top: 0; left: 50%; transform: translateX(-50%) rotate(45deg);
  width: 64rpx; height: 64rpx; background: #fff; border-radius: 10rpx;
}
.cap-base {
  position: absolute; top: 34rpx; left: 50%; transform: translateX(-50%);
  width: 52rpx; height: 30rpx; background: #fff; border-radius: 0 0 10rpx 10rpx; opacity: .92;
}
.cap-tassel {
  position: absolute; top: 30rpx; right: 2rpx; width: 4rpx; height: 32rpx;
  background: #ffd36e; border-radius: 2rpx;
}
.cap-tassel::after {
  content: ''; position: absolute; bottom: -6rpx; left: -4rpx;
  width: 12rpx; height: 12rpx; border-radius: 50%; background: #ffd36e;
}

/* 文字 */
.title {
  color: #fff; font-size: 52rpx; font-weight: 700; letter-spacing: 6rpx; margin-top: 40rpx;
  opacity: 0; transform: translateY(24rpx);
  transition: opacity .6s ease .25s, transform .6s ease .25s;
}
.slogan {
  color: rgba(255,255,255,.85); font-size: 26rpx; letter-spacing: 2rpx; margin-top: 18rpx;
  opacity: 0; transform: translateY(20rpx);
  transition: opacity .6s ease .45s, transform .6s ease .45s;
}
.splash.go .title { opacity: 1; transform: translateY(0); }
.splash.go .slogan { opacity: 1; transform: translateY(0); }

/* 能力圆点依次点亮 */
.dots { display: flex; margin-top: 48rpx; }
.dot { width: 16rpx; height: 16rpx; border-radius: 50%; margin: 0 10rpx; background: rgba(255,255,255,.9);
  opacity: 0; transform: scale(.4); transition: opacity .4s ease, transform .4s ease; }
.splash.go .dot { opacity: 1; transform: scale(1); }
.splash.go .d0 { transition-delay: .7s; }
.splash.go .d1 { transition-delay: .85s; }
.splash.go .d2 { transition-delay: 1.0s; }
.splash.go .d3 { transition-delay: 1.15s; }
/* 点亮后轻微呼吸 */
.splash.go .dot { animation: breathe 1.6s ease-in-out 1.4s infinite; }
@keyframes breathe { 0%,100% { opacity: 1; } 50% { opacity: .5; } }

/* 底部 */
.foot { position: absolute; bottom: 70rpx; z-index: 2;
  opacity: 0; transition: opacity .8s ease 1s; }
.splash.go .foot { opacity: 1; }
.foot-t { color: rgba(255,255,255,.6); font-size: 22rpx; letter-spacing: 1rpx; }

.skip-hint { position: absolute; top: 90rpx; right: 44rpx; z-index: 2;
  color: rgba(255,255,255,.55); font-size: 22rpx;
  opacity: 0; transition: opacity .6s ease 1.2s; }
.splash.go .skip-hint { opacity: 1; }
