.doc { padding: 8rpx 40rpx 60rpx; }

.doc-head { padding: 36rpx 0 28rpx; border-bottom: 1rpx solid #eef1f5; }
.doc-title { display: block; font-size: 40rpx; font-weight: 700; color: #1a2233; }
.doc-updated { display: block; font-size: 24rpx; color: #9aa6b5; margin-top: 14rpx; }

.sec { margin-top: 40rpx; }
.sec-h { display: block; font-size: 30rpx; font-weight: 600; color: #1a2233; margin-bottom: 14rpx; }
.sec-p { display: block; font-size: 27rpx; color: #5a6684; line-height: 1.75; margin-top: 10rpx; text-align: justify; }

.doc-foot { text-align: center; font-size: 22rpx; color: #b6c0cf; margin-top: 70rpx; }
