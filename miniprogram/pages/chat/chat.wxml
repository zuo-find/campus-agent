<view class="chat-container">
  <!-- 当前模型条：点开可切换厂商、填自己的 Key -->
  <view class="model-bar" bindtap="goModel">
    <view class="mb-dot"></view>
    <text class="mb-name">{{modelLabel}}</text>
    <text class="mb-switch">切换模型 ›</text>
  </view>

  <scroll-view class="msg-list" scroll-y scroll-top="{{scrollTop}}" scroll-with-animation>
    <!-- 还没聊过：先给一块能上手的欢迎区，别让首屏空着 -->
    <view wx:if="{{!messages.length}}" class="welcome">
      <text class="wc-hello">{{greeting}}，我是校园助手</text>
      <text class="wc-sub">查制度、写材料、查日程、算绩点 —— 说一句话就能用</text>

      <view class="wc-kb" bindtap="openKb">
        <view class="wc-kb-dot"></view>
        <text class="wc-kb-t" wx:if="{{kb.chunks}}">已收录 {{kb.docs}} 篇校内资料 · {{kb.chunks}} 个知识片段</text>
        <text class="wc-kb-t" wx:else>正在读取知识库…</text>
        <text class="wc-kb-a" wx:if="{{kb.sources.length}}">查看 ›</text>
      </view>

      <view class="wc-grid">
        <view class="wc-card" wx:for="{{welcomeCards}}" wx:key="key"
              data-key="{{item.key}}" hover-class="wc-card-hover" hover-stay-time="80" bindtap="onWelcomeCard">
          <view class="wc-line">
            <view class="wc-dot {{item.tone}}"></view>
            <text class="wc-label">{{item.label}}</text>
          </view>
          <text class="wc-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>

    <block wx:for="{{messages}}" wx:key="index">
      <view class="msg-row {{item.role}}">
        <view class="bubble {{item.role}} {{item.image ? 'img-bubble' : ''}}" data-idx="{{index}}" bindlongpress="copyMsg">
          <image wx:if="{{item.image}}" class="bubble-img" src="{{item.image}}" mode="widthFix" />
          <!-- 这一轮带上了哪些文件 -->
          <view wx:if="{{item.files.length}}" class="bubble-files">
            <text class="bf-item" wx:for="{{item.files}}" wx:for-item="fn" wx:key="*this">{{fn}}</text>
          </view>
          <view wx:if="{{item.agentName}}" class="agent-chip ac-{{item.agent}}">{{item.agentName}}</view>
          <text class="bubble-text">{{item.content}}</text>
          <view wx:if="{{item.myFiles.length}}" class="sources">
            <text class="src-tag mine" wx:for="{{item.myFiles}}" wx:for-item="s" wx:key="*this">你的文件 · {{s}}</text>
          </view>
          <view wx:if="{{item.sources.length}}" class="sources">
            <text class="src-tag" wx:for="{{item.sources}}" wx:for-item="s" wx:key="*this">来源：{{s}}</text>
          </view>
        </view>
      </view>

      <!-- 识别出的文字：可以展开核对 -->
      <view wx:if="{{item.ocr}}" class="ocr-card">
        <view class="ocr-head" data-idx="{{index}}" bindtap="toggleOcr">
          <text class="ocr-badge">识别文字</text>
          <text class="ocr-hint">{{item.ocrOpen ? '收起' : '展开核对'}}</text>
          <text class="ocr-arrow {{item.ocrOpen ? 'up' : ''}}">⌄</text>
        </view>
        <scroll-view wx:if="{{item.ocrOpen}}" class="ocr-scroll" scroll-y>
          <text class="ocr-text">{{item.ocr}}</text>
        </scroll-view>
        <text wx:else class="ocr-text clip">{{item.ocr}}</text>
      </view>

      <!-- 待办清单卡片 -->
      <view wx:if="{{item.todos}}" class="todo-card">
        <view class="tc-head"><view class="tc-badge">待办</view><text class="tc-title">关键时间点</text></view>
        <view class="tc-item" wx:for="{{item.todos}}" wx:for-item="t" wx:key="title">
          <view class="tc-dot {{t.urgent ? 'urgent' : ''}}"></view>
          <view class="tc-main">
            <text class="tc-t">{{t.title}}</text>
            <text class="tc-note" wx:if="{{t.note}}">{{t.note}}</text>
          </view>
          <view class="tc-right">
            <text class="tc-due">{{t.due_text}}</text>
            <text class="tc-days {{t.urgent ? 'urgent' : ''}}">{{t.days_text}}</text>
          </view>
        </view>
      </view>

      <!-- 材料卡片：可编辑字段、导出 Word -->
      <view wx:if="{{item.doc}}" class="doc-card">
        <view class="dc-head">
          <view class="dc-badge">材料</view>
          <text class="dc-title">{{item.doc.title}}</text>
        </view>
        <scroll-view class="dc-preview" scroll-y>
          <text class="dc-text">{{item.doc.text}}</text>
        </scroll-view>
        <view class="dc-btns">
          <view class="dc-btn ghost" data-idx="{{index}}" bindtap="editDoc">编辑字段</view>
          <view class="dc-btn primary" data-idx="{{index}}" bindtap="exportDoc">导出 Word</view>
        </view>
      </view>
    </block>
    <!-- 等待回答：把后端实际的处理流程显示出来，比一句"正在思考"有信息 -->
    <view wx:if="{{loading}}" class="msg-row assistant">
      <view class="bubble assistant think-bubble">
        <view class="think-row {{thinkStep >= index ? 'on' : ''}}" wx:for="{{thinkSteps}}" wx:key="*this">
          <view class="think-dot {{thinkStep == index ? 'live' : ''}}"></view>
          <text class="think-t">{{item}}</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 能力入口：对应后台的四个智能体 -->
  <view class="cap-bar">
    <view class="cap-chip" wx:for="{{caps}}" wx:key="label"
          data-cap="{{item.key}}" hover-class="cap-hover" hover-stay-time="80" catchtap="onCap">
      <view class="cap-dot {{item.tone}}"></view>
      <text class="cap-t">{{item.label}}</text>
    </view>
  </view>

  <view class="quick-bar">
    <text class="quick-l">{{quickLabel}}</text>
    <scroll-view class="quick-scroll" scroll-x>
      <view wx:for="{{quickAsks}}" wx:key="*this" class="quick-chip" data-q="{{item}}" bindtap="onQuick">{{item}}</view>
    </scroll-view>
  </view>

  <!-- 已选的文件：解析结果留在这一栏，后面追问会一起带上 -->
  <view wx:if="{{atts.length}}" class="att-bar">
    <view class="att-head">
      <text class="att-tip">{{atts.length}} 个文件 · 之后每次提问都会带上</text>
      <text class="att-clear" bindtap="clearAtts">全部移除</text>
    </view>
    <scroll-view class="att-scroll" scroll-x>
      <view class="att-chip" wx:for="{{atts}}" wx:key="id">
        <text class="att-n">{{item.name}}</text>
        <text class="att-c">{{item.chars}} 字</text>
        <text class="att-x" data-i="{{index}}" catchtap="removeAtt">✕</text>
      </view>
    </scroll-view>
  </view>

  <view class="input-bar">
    <!-- 上传文件（小程序不能选文件夹，只能一次批量选文件） -->
    <view class="file-btn" hover-class="file-hover" hover-stay-time="80" bindtap="pickFiles">
      <view class="file-body"></view>
      <view class="file-line l1"></view>
      <view class="file-line l2"></view>
      <view class="file-line l3"></view>
    </view>
    <!-- 拍照识别入口（纯 CSS 画的相机，不用图标字体） -->
    <view class="cam-btn" hover-class="cam-hover" hover-stay-time="80" bindtap="pickImage">
      <view class="cam-body"><view class="cam-lens"></view></view>
      <view class="cam-top"></view>
    </view>
    <input class="input" value="{{input}}" placeholder="问制度，或「帮我写一份请假条…」"
           confirm-type="send" bindinput="onInput" bindconfirm="send" />
    <button class="send-btn" bindtap="send" disabled="{{loading}}">发送</button>
  </view>

  <!-- 拍完先选用途：决定这张图走哪条链路 -->
  <view wx:if="{{imgSheet}}" class="de-mask" bindtap="closeImgSheet">
    <view class="de-sheet" catchtap="noop">
      <view class="de-h">这张图要做什么？<text class="de-x" catchtap="closeImgSheet">✕</text></view>
      <view class="vm-list">
        <view class="vm-item" wx:for="{{vModes}}" wx:key="key"
              data-mode="{{item.key}}" hover-class="vm-hover" hover-stay-time="80" bindtap="pickImgMode">
          <view class="vm-main">
            <text class="vm-t">{{item.label}}</text>
            <text class="vm-d">{{item.desc}}</text>
          </view>
          <text class="vm-a">›</text>
        </view>
      </view>
      <view class="vm-tip">识别用多模态模型，可在「我的 → 大模型设置 → 识图模型」里更换。</view>
    </view>
  </view>

  <!-- 成绩单识别结果：确认后再写进成绩页 -->
  <view wx:if="{{scoreShow}}" class="de-mask" bindtap="closeScore">
    <view class="de-sheet" catchtap="noop">
      <view class="de-h">识别到的课程<text class="de-x" catchtap="closeScore">✕</text></view>
      <view class="sc-tip">点一下可以取消勾选，确认无误再导入。成绩只写进你手机本地。</view>
      <scroll-view class="sc-body" scroll-y>
        <view class="sc-item" wx:for="{{scoreList}}" wx:key="name" data-i="{{index}}" bindtap="toggleScore">
          <view class="cb {{item.on ? 'on' : ''}}">{{item.on ? '✓' : ''}}</view>
          <view class="sc-main">
            <text class="sc-n">{{item.name}}</text>
            <text class="sc-s">{{item.credit}} 学分</text>
          </view>
          <text class="sc-score">{{item.score}}</text>
        </view>
      </scroll-view>
      <button class="btn-primary" bindtap="importScores">导入到成绩页</button>
    </view>
  </view>

  <!-- 知识库收录了哪些资料 -->
  <view wx:if="{{kbShow}}" class="de-mask" bindtap="closeKb">
    <view class="de-sheet" catchtap="noop">
      <view class="de-h">知识库收录的资料<text class="de-x" catchtap="closeKb">✕</text></view>
      <scroll-view class="de-body kb-body" scroll-y>
        <view class="kb-item" wx:for="{{kb.sources}}" wx:key="*this">
          <view class="kb-dot"></view><text class="kb-t">{{item}}</text>
        </view>
        <view class="kb-note">共 {{kb.docs}} 篇 · {{kb.chunks}} 个知识片段。回答制度类问题时会从这里检索原文，并在答案下方标出来源。</view>
      </scroll-view>
    </view>
  </view>

  <!-- 材料类型选择 -->
  <view wx:if="{{docPick}}" class="de-mask" bindtap="closeDocPick">
    <view class="de-sheet" catchtap="noop">
      <view class="de-h">写哪种材料？<text class="de-x" catchtap="closeDocPick">✕</text></view>
      <view class="dp-grid">
        <view class="dp-item" wx:for="{{docTypes}}" wx:key="*this" data-t="{{item}}" bindtap="pickDocType">{{item}}</view>
      </view>
    </view>
  </view>

  <!-- 字段编辑弹层 -->
  <view wx:if="{{docEdit.show}}" class="de-mask" bindtap="closeDocEdit">
    <view class="de-sheet" catchtap="noop">
      <view class="de-h">编辑「{{docEdit.title}}」<text class="de-x" catchtap="closeDocEdit">✕</text></view>
      <scroll-view class="de-body" scroll-y>
        <view class="de-row" wx:for="{{docEdit.fields}}" wx:key="label">
          <text class="de-label">{{item.label}}</text>
          <textarea wx:if="{{item.multi}}" class="de-area" value="{{item.value}}" placeholder="—"
                    data-i="{{index}}" bindinput="onFieldInput" auto-height maxlength="500" />
          <input wx:else class="de-input" value="{{item.value}}" placeholder="—"
                 data-i="{{index}}" bindinput="onFieldInput" />
        </view>
      </scroll-view>
      <button class="btn-primary de-save" bindtap="saveDocEdit">保存修改</button>
    </view>
  </view>
</view>
