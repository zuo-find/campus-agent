.chat-container { display: flex; flex-direction: column; height: 100vh; box-sizing: border-box; }

/* 当前模型条 */
.model-bar {
  display: flex; align-items: center; background: #fff;
  padding: 18rpx 28rpx; border-bottom: 1rpx solid #eef1f5;
}
.mb-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: #1a73e8; margin-right: 16rpx; flex-shrink: 0; }
.mb-name { flex: 1; font-size: 26rpx; color: #24324a; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.mb-switch { font-size: 24rpx; color: #1a73e8; }

.msg-list { flex: 1; padding: 20rpx 0; overflow: hidden; }

/* ---------- 首屏欢迎区 ---------- */
/* 首屏没有对话内容，整块上下居中，别堆在顶上留一大片空白 */
.welcome {
  display: flex; flex-direction: column; justify-content: center;
  min-height: calc(100vh - 420rpx); padding: 26rpx 24rpx 10rpx; box-sizing: border-box;
}
.wc-hello { display: block; font-size: 42rpx; font-weight: 700; color: #1a2233; }
.wc-sub { display: block; font-size: 26rpx; color: #8c98ab; line-height: 1.7; margin-top: 14rpx; }

.wc-kb {
  display: flex; align-items: center; background: #fff; border: 1rpx solid #e6ebf3;
  border-radius: 14rpx; padding: 18rpx 22rpx; margin-top: 26rpx;
}
.wc-kb:active { background: #f3f6fb; }
.wc-kb-dot {
  width: 12rpx; height: 12rpx; border-radius: 50%; background: #1a73e8;
  margin-right: 14rpx; flex-shrink: 0;
}
.wc-kb-t { flex: 1; font-size: 24rpx; color: #5a6684; }
.wc-kb-a { font-size: 23rpx; color: #1a73e8; }

.wc-grid { display: flex; flex-wrap: wrap; margin-top: 22rpx; }
.wc-card {
  width: calc(50% - 20rpx); box-sizing: border-box; background: #fff;
  border: 1rpx solid #e6ebf3; border-radius: 16rpx; padding: 22rpx 20rpx;
  margin: 0 20rpx 20rpx 0; box-shadow: 0 2rpx 10rpx rgba(24,39,75,.04);
}
.wc-card:nth-child(2n) { margin-right: 0; }
.wc-card-hover { background: #f3f6fb; }
.wc-line { display: flex; align-items: center; }
.wc-dot { width: 12rpx; height: 12rpx; border-radius: 50%; margin-right: 12rpx; flex-shrink: 0; }
.wc-dot.qa { background: #1a73e8; }
.wc-dot.doc { background: #10b981; }
.wc-dot.schedule { background: #ff8a00; }
.wc-dot.study { background: #7c3aed; }
.wc-label { font-size: 29rpx; font-weight: 600; color: #1a2233; }
.wc-desc { display: block; font-size: 23rpx; color: #9aa6b5; margin-top: 10rpx; }

/* ---------- 等待回答的流程提示 ---------- */
.think-bubble { padding: 16rpx 22rpx; }
.think-row { display: flex; align-items: center; padding: 7rpx 0; opacity: .3; }
.think-row.on { opacity: 1; }
.think-dot {
  width: 12rpx; height: 12rpx; border-radius: 50%; background: #1a73e8;
  margin-right: 16rpx; flex-shrink: 0;
}
.think-dot.live { animation: blink 1s ease-in-out infinite; }
.think-t { font-size: 25rpx; color: #5a6684; }
@keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: .25; } }

.msg-row { display: flex; padding: 12rpx 24rpx; }
.msg-row.user { justify-content: flex-end; }
.msg-row.assistant { justify-content: flex-start; }

.bubble { max-width: 78%; padding: 20rpx 24rpx; border-radius: 18rpx; word-break: break-all; }
.bubble.user { background: #1a73e8; }
.bubble.user .bubble-text { color: #fff; }
.bubble.assistant { background: #fff; }
.bubble-text { display: block; font-size: 30rpx; line-height: 1.5; white-space: pre-wrap; color: #222; }

/* 是哪个 Agent 在应答 */
.agent-chip { display: inline-block; font-size: 20rpx; border-radius: 6rpx; padding: 3rpx 12rpx; margin-bottom: 10rpx; }
.agent-chip.ac-qa { color: #1a73e8; background: #eaf1fe; }
.agent-chip.ac-study { color: #7c3aed; background: #f3eeff; }
.agent-chip.ac-doc { color: #0f9d63; background: #e6f8f0; }
.agent-chip.ac-schedule { color: #d97706; background: #fff5e6; }

.sources { margin-top: 14rpx; display: flex; flex-wrap: wrap; }
.src-tag {
  font-size: 22rpx; color: #1a73e8; background: #eaf1fe;
  padding: 4rpx 14rpx; border-radius: 20rpx; margin: 6rpx 8rpx 0 0;
}
/* 用户自己上传的文件：用绿色跟校园知识库区分开 */
.src-tag.mine { color: #0f7a4d; background: #e6f8f0; }

/* ---------- 图片气泡 & 识别文字 ---------- */
.bubble.img-bubble { background: transparent; padding: 0; }
.bubble-img { width: 380rpx; border-radius: 14rpx; display: block; }
.bubble.img-bubble .bubble-text { font-size: 24rpx; color: #8c98ab; margin-top: 10rpx; text-align: right; }

.ocr-card { margin: 8rpx 24rpx 20rpx; background: #fff; border-radius: 18rpx; overflow: hidden;
  border: 1rpx solid #e6ebf3; box-shadow: 0 8rpx 24rpx rgba(24,39,75,.06); }
.ocr-head { display: flex; align-items: center; padding: 20rpx 24rpx; }
.ocr-badge { font-size: 20rpx; color: #5a6684; background: #f0f3f8; border-radius: 6rpx; padding: 4rpx 12rpx; margin-right: 14rpx; }
.ocr-hint { flex: 1; font-size: 24rpx; color: #9aa6b5; }
.ocr-arrow { font-size: 30rpx; color: #c6d0de; line-height: 1; transition: transform .2s; }
.ocr-arrow.up { transform: rotate(180deg); }
.ocr-text { display: block; font-size: 25rpx; color: #5a6684; line-height: 1.75; white-space: pre-wrap;
  padding: 0 24rpx 22rpx; border-top: 1rpx solid #f2f4f8; padding-top: 18rpx; margin-top: -1rpx; }
.ocr-text.clip { max-height: 132rpx; overflow: hidden; }
.ocr-scroll { max-height: 620rpx; padding: 0 0 12rpx; }

/* ---------- 材料卡片 ---------- */
.doc-card { margin: 8rpx 24rpx 20rpx; background: #fff; border-radius: 18rpx; overflow: hidden;
  border: 1rpx solid #e6ebf3; box-shadow: 0 8rpx 24rpx rgba(24,39,75,.06); }
.dc-head { display: flex; align-items: center; padding: 22rpx 24rpx 14rpx; }
.dc-badge { font-size: 20rpx; color: #1a73e8; background: #eaf1fe; border-radius: 6rpx; padding: 4rpx 12rpx; margin-right: 14rpx; }
.dc-title { flex: 1; font-size: 30rpx; font-weight: 600; color: #1a2233; }
.dc-preview { max-height: 380rpx; padding: 0 24rpx; }
.dc-text { display: block; font-size: 25rpx; color: #5a6684; line-height: 1.7; white-space: pre-wrap;
  padding-bottom: 16rpx; border-top: 1rpx solid #f2f4f8; padding-top: 16rpx; }
.dc-btns { display: flex; padding: 0 24rpx 24rpx; }
.dc-btn { flex: 1; text-align: center; font-size: 27rpx; line-height: 76rpx; border-radius: 12rpx; }
.dc-btn.ghost { color: #1a73e8; border: 1rpx solid #cfe0fb; margin-right: 20rpx; }
.dc-btn.primary { color: #fff; background: #1a73e8; }

/* ---------- 待办清单卡片 ---------- */
.todo-card { margin: 8rpx 24rpx 20rpx; background: #fff; border-radius: 18rpx; overflow: hidden;
  border: 1rpx solid #f3e7d3; box-shadow: 0 8rpx 24rpx rgba(24,39,75,.06); }
.tc-head { display: flex; align-items: center; padding: 22rpx 24rpx 12rpx; }
.tc-badge { font-size: 20rpx; color: #d97706; background: #fff5e6; border-radius: 6rpx; padding: 4rpx 12rpx; margin-right: 14rpx; }
.tc-title { flex: 1; font-size: 30rpx; font-weight: 600; color: #1a2233; }
.tc-item { display: flex; align-items: center; padding: 18rpx 24rpx; border-top: 1rpx solid #f5f7fa; }
.tc-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #c6d0de; margin-right: 18rpx; flex-shrink: 0; }
.tc-dot.urgent { background: #ff8a00; }
.tc-main { flex: 1; min-width: 0; }
.tc-t { display: block; font-size: 28rpx; color: #1a2233; }
.tc-note { display: block; font-size: 22rpx; color: #9aa6b5; margin-top: 4rpx; }
.tc-right { display: flex; flex-direction: column; align-items: flex-end; margin-left: 16rpx; }
.tc-due { font-size: 24rpx; color: #5a6684; }
.tc-days { font-size: 22rpx; color: #a6b0c0; margin-top: 4rpx; }
.tc-days.urgent { color: #ff8a00; font-weight: 600; }

/* ---------- 字段编辑弹层 ---------- */
.de-mask { position: fixed; inset: 0; background: rgba(16,24,40,.5); z-index: 60; display: flex; align-items: flex-end; }
.de-sheet { width: 100%; background: #fff; border-radius: 28rpx 28rpx 0 0; padding: 28rpx 32rpx 40rpx; box-sizing: border-box; }
.de-h { position: relative; text-align: center; font-size: 32rpx; font-weight: 600; color: #1a2233; padding-bottom: 20rpx; }
.de-x { position: absolute; right: 0; top: 0; font-size: 30rpx; color: #a6b0c0; padding: 0 8rpx; }
.de-body { max-height: 840rpx; }
.de-row { margin-bottom: 22rpx; }
.de-label { display: block; font-size: 25rpx; color: #8c98ab; margin-bottom: 10rpx; }
.de-input, .de-area { width: 100%; box-sizing: border-box; background: #f2f5fa; border-radius: 10rpx;
  padding: 18rpx 20rpx; font-size: 28rpx; color: #1a2233; }
.de-area { min-height: 120rpx; line-height: 1.6; }
.de-save { margin-top: 10rpx; }

/* ---------- 能力入口条 ---------- */
.cap-bar { display: flex; padding: 14rpx 16rpx 4rpx; background: #f5f6f8; }
.cap-chip {
  flex: 1; display: flex; align-items: center; justify-content: center;
  background: #fff; border-radius: 14rpx; padding: 14rpx 0; margin-right: 12rpx;
  border: 1rpx solid #e6ebf3; box-shadow: 0 2rpx 8rpx rgba(24,39,75,.04);
}
.cap-chip:last-child { margin-right: 0; }
.cap-chip:active { background: #f3f6fb; }
.cap-hover { background: #eaf1fe; }
.cap-dot { width: 12rpx; height: 12rpx; border-radius: 50%; margin-right: 10rpx; flex-shrink: 0; }
.cap-dot.qa { background: #1a73e8; }
.cap-dot.doc { background: #10b981; }
.cap-dot.schedule { background: #ff8a00; }
.cap-dot.study { background: #7c3aed; }
.cap-t { font-size: 25rpx; color: #3d4a63; }

/* 材料类型选择 */
.dp-grid { display: flex; flex-wrap: wrap; padding: 6rpx 0 10rpx; }
.dp-item {
  width: calc(50% - 16rpx); box-sizing: border-box; margin: 8rpx 8rpx;
  text-align: center; font-size: 29rpx; color: #1a2233; background: #f2f5fa;
  border-radius: 14rpx; line-height: 92rpx;
}
.dp-item:active { background: #e7eefb; }

.quick-bar { display: flex; align-items: center; padding: 12rpx 16rpx; background: #f5f6f8; }
.quick-l { font-size: 22rpx; color: #9aa6b5; margin-right: 14rpx; flex-shrink: 0; }
.quick-scroll { flex: 1; white-space: nowrap; }
.quick-chip {
  display: inline-block; font-size: 26rpx; color: #1a73e8;
  background: #fff; border: 1rpx solid #d4e2fc;
  padding: 10rpx 22rpx; border-radius: 30rpx; margin-right: 14rpx;
}

/* ---------- 知识库资料清单 ---------- */
.kb-body { max-height: 760rpx; }
.kb-item { display: flex; align-items: flex-start; padding: 18rpx 0; border-bottom: 1rpx solid #f2f4f8; }
.kb-dot {
  width: 10rpx; height: 10rpx; border-radius: 50%; background: #1a73e8;
  margin: 14rpx 16rpx 0 0; flex-shrink: 0;
}
.kb-t { flex: 1; font-size: 26rpx; color: #1a2233; line-height: 1.55; word-break: break-all; }
.kb-note { font-size: 23rpx; color: #9aa6b5; line-height: 1.75; margin-top: 22rpx; }

.input-bar {
  display: flex; align-items: center; padding: 16rpx 24rpx;
  background: #fff; border-top: 1rpx solid #eee;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

/* 「+」：两笔细线，不用图标资源。拍图和文件都收在这一个入口里 */
.plus-btn { position: relative; width: 68rpx; height: 68rpx; margin-right: 14rpx; flex-shrink: 0; }
.plus-bar { position: absolute; background: #5a6684; border-radius: 2rpx; }
.plus-bar.h { left: 15rpx; top: 32rpx; width: 38rpx; height: 4rpx; }
.plus-bar.v { left: 32rpx; top: 15rpx; width: 4rpx; height: 38rpx; }
.plus-hover .plus-bar { background: #1a73e8; }

/* 已选文件栏 */
.att-bar { padding: 14rpx 24rpx 12rpx; background: #f5f6f8; border-top: 1rpx solid #eef1f5; }
.att-head { display: flex; align-items: center; margin-bottom: 10rpx; }
.att-tip { flex: 1; font-size: 22rpx; color: #8c98ab; }
.att-clear { font-size: 22rpx; color: #1a73e8; }
.att-scroll { white-space: nowrap; }
.att-chip {
  display: inline-flex; align-items: center; background: #fff; border: 1rpx solid #d4e2fc;
  border-radius: 30rpx; padding: 10rpx 12rpx 10rpx 20rpx; margin-right: 14rpx; max-width: 460rpx;
}
.att-n {
  font-size: 24rpx; color: #1a2233; max-width: 260rpx;
  overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.att-c { font-size: 20rpx; color: #9aa6b5; margin-left: 10rpx; }
.att-x { font-size: 22rpx; color: #a6b0c0; padding: 0 8rpx 0 12rpx; }

/* 气泡里显示这轮带了哪些文件 */
.bubble-files { margin-bottom: 10rpx; }
.bf-item {
  display: inline-block; font-size: 21rpx; color: #1a73e8; background: #eaf1fe;
  border-radius: 6rpx; padding: 4rpx 12rpx; margin: 0 8rpx 6rpx 0;
}
.bubble.user .bf-item { color: #fff; background: rgba(255,255,255,.22); }

/* 拍摄用途选择 */
.vm-list { padding: 6rpx 0 4rpx; }
.vm-item { display: flex; align-items: center; padding: 22rpx 0; border-bottom: 1rpx solid #f2f4f8; }
.vm-item:last-child { border-bottom: none; }
.vm-hover { background: #f7f9fd; }
.vm-main { flex: 1; min-width: 0; }
.vm-t { display: block; font-size: 29rpx; color: #1a2233; }
.vm-d { display: block; font-size: 23rpx; color: #9aa6b5; margin-top: 6rpx; }
.vm-a { color: #c6d0de; font-size: 34rpx; margin-left: 12rpx; }
.vm-tip { font-size: 22rpx; color: #a6b0c0; line-height: 1.6; margin-top: 18rpx; }

/* 成绩单识别结果确认 */
.sc-tip { font-size: 23rpx; color: #9aa6b5; line-height: 1.7; margin-bottom: 12rpx; }
.sc-body { max-height: 640rpx; }
.sc-item { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #f2f4f8; }
.cb {
  width: 34rpx; height: 34rpx; border-radius: 50%; border: 2rpx solid #c6d0de;
  margin-right: 18rpx; flex-shrink: 0; box-sizing: border-box;
  display: flex; align-items: center; justify-content: center;
  font-size: 21rpx; color: #fff; transition: all .15s;
}
.cb.on { background: #1a73e8; border-color: #1a73e8; }
.sc-main { flex: 1; min-width: 0; }
.sc-n { display: block; font-size: 28rpx; color: #1a2233; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.sc-s { display: block; font-size: 22rpx; color: #9aa6b5; margin-top: 4rpx; }
.sc-score { font-size: 32rpx; font-weight: 700; color: #1a73e8; }
.input {
  flex: 1; background: #f0f1f3; border-radius: 36rpx;
  padding: 18rpx 28rpx; font-size: 30rpx;
}
.send-btn {
  margin-left: 16rpx; background: #1a73e8; color: #fff;
  font-size: 28rpx; border-radius: 36rpx; padding: 0 36rpx; line-height: 72rpx;
}
.send-btn[disabled] { background: #a9c4f5; }
