.chat-container { display: flex; flex-direction: column; height: 100vh; box-sizing: border-box; }

/* 当前模型条 */
.model-bar {
  display: flex; align-items: center; background: #fff;
  padding: 18rpx 28rpx; border-bottom: 1rpx solid #eef1f5;
}
.mb-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: #1a73e8; margin-right: 16rpx; flex-shrink: 0; }
.mb-name { flex: 1; font-size: 26rpx; color: #24324a; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.mb-switch { font-size: 24rpx; color: #1a73e8; }

.msg-list { flex: 1; padding: 20rpx 0; overflow: hidden; }

.msg-row { display: flex; padding: 12rpx 24rpx; }
.msg-row.user { justify-content: flex-end; }
.msg-row.assistant { justify-content: flex-start; }

.bubble { max-width: 78%; padding: 20rpx 24rpx; border-radius: 18rpx; word-break: break-all; }
.bubble.user { background: #1a73e8; }
.bubble.user .bubble-text { color: #fff; }
.bubble.assistant { background: #fff; }
.bubble-text { font-size: 30rpx; line-height: 1.5; white-space: pre-wrap; color: #222; }

/* 是哪个 Agent 在应答 */
.agent-chip { display: inline-block; font-size: 20rpx; border-radius: 6rpx; padding: 3rpx 12rpx; margin-bottom: 10rpx; }
.agent-chip.ac-qa { color: #1a73e8; background: #eaf1fe; }
.agent-chip.ac-study { color: #7c3aed; background: #f3eeff; }
.agent-chip.ac-doc { color: #0f9d63; background: #e6f8f0; }
.agent-chip.ac-schedule { color: #d97706; background: #fff5e6; }

.sources { margin-top: 14rpx; display: flex; flex-wrap: wrap; }
.src-tag {
  font-size: 22rpx; color: #1a73e8; background: #eaf1fe;
  padding: 4rpx 14rpx; border-radius: 20rpx; margin: 6rpx 8rpx 0 0;
}

/* ---------- 材料卡片 ---------- */
.doc-card { margin: 8rpx 24rpx 20rpx; background: #fff; border-radius: 18rpx; overflow: hidden;
  border: 1rpx solid #e6ebf3; box-shadow: 0 8rpx 24rpx rgba(24,39,75,.06); }
.dc-head { display: flex; align-items: center; padding: 22rpx 24rpx 14rpx; }
.dc-badge { font-size: 20rpx; color: #1a73e8; background: #eaf1fe; border-radius: 6rpx; padding: 4rpx 12rpx; margin-right: 14rpx; }
.dc-title { flex: 1; font-size: 30rpx; font-weight: 600; color: #1a2233; }
.dc-preview { max-height: 380rpx; padding: 0 24rpx; }
.dc-text { display: block; font-size: 25rpx; color: #5a6684; line-height: 1.7; white-space: pre-wrap;
  padding-bottom: 16rpx; border-top: 1rpx solid #f2f4f8; padding-top: 16rpx; }
.dc-btns { display: flex; padding: 0 24rpx 24rpx; }
.dc-btn { flex: 1; text-align: center; font-size: 27rpx; line-height: 76rpx; border-radius: 12rpx; }
.dc-btn.ghost { color: #1a73e8; border: 1rpx solid #cfe0fb; margin-right: 20rpx; }
.dc-btn.primary { color: #fff; background: #1a73e8; }

/* ---------- 待办清单卡片 ---------- */
.todo-card { margin: 8rpx 24rpx 20rpx; background: #fff; border-radius: 18rpx; overflow: hidden;
  border: 1rpx solid #f3e7d3; box-shadow: 0 8rpx 24rpx rgba(24,39,75,.06); }
.tc-head { display: flex; align-items: center; padding: 22rpx 24rpx 12rpx; }
.tc-badge { font-size: 20rpx; color: #d97706; background: #fff5e6; border-radius: 6rpx; padding: 4rpx 12rpx; margin-right: 14rpx; }
.tc-title { flex: 1; font-size: 30rpx; font-weight: 600; color: #1a2233; }
.tc-item { display: flex; align-items: center; padding: 18rpx 24rpx; border-top: 1rpx solid #f5f7fa; }
.tc-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #c6d0de; margin-right: 18rpx; flex-shrink: 0; }
.tc-dot.urgent { background: #ff8a00; }
.tc-main { flex: 1; min-width: 0; }
.tc-t { display: block; font-size: 28rpx; color: #1a2233; }
.tc-note { display: block; font-size: 22rpx; color: #9aa6b5; margin-top: 4rpx; }
.tc-right { display: flex; flex-direction: column; align-items: flex-end; margin-left: 16rpx; }
.tc-due { font-size: 24rpx; color: #5a6684; }
.tc-days { font-size: 22rpx; color: #a6b0c0; margin-top: 4rpx; }
.tc-days.urgent { color: #ff8a00; font-weight: 600; }

/* ---------- 字段编辑弹层 ---------- */
.de-mask { position: fixed; inset: 0; background: rgba(16,24,40,.5); z-index: 60; display: flex; align-items: flex-end; }
.de-sheet { width: 100%; background: #fff; border-radius: 28rpx 28rpx 0 0; padding: 28rpx 32rpx 40rpx; box-sizing: border-box; }
.de-h { position: relative; text-align: center; font-size: 32rpx; font-weight: 600; color: #1a2233; padding-bottom: 20rpx; }
.de-x { position: absolute; right: 0; top: 0; font-size: 30rpx; color: #a6b0c0; padding: 0 8rpx; }
.de-body { max-height: 840rpx; }
.de-row { margin-bottom: 22rpx; }
.de-label { display: block; font-size: 25rpx; color: #8c98ab; margin-bottom: 10rpx; }
.de-input, .de-area { width: 100%; box-sizing: border-box; background: #f2f5fa; border-radius: 10rpx;
  padding: 18rpx 20rpx; font-size: 28rpx; color: #1a2233; }
.de-area { min-height: 120rpx; line-height: 1.6; }
.de-save { margin-top: 10rpx; }

/* ---------- 能力入口条 ---------- */
.cap-bar { display: flex; padding: 14rpx 16rpx 4rpx; background: #f5f6f8; }
.cap-chip {
  flex: 1; display: flex; align-items: center; justify-content: center;
  background: #fff; border-radius: 14rpx; padding: 14rpx 0; margin-right: 12rpx;
  border: 1rpx solid #e6ebf3; box-shadow: 0 2rpx 8rpx rgba(24,39,75,.04);
}
.cap-chip:last-child { margin-right: 0; }
.cap-chip:active { background: #f3f6fb; }
.cap-dot { width: 12rpx; height: 12rpx; border-radius: 50%; margin-right: 10rpx; flex-shrink: 0; }
.cap-dot.qa { background: #1a73e8; }
.cap-dot.doc { background: #10b981; }
.cap-dot.schedule { background: #ff8a00; }
.cap-dot.study { background: #7c3aed; }
.cap-t { font-size: 25rpx; color: #3d4a63; }

/* 材料类型选择 */
.dp-grid { display: flex; flex-wrap: wrap; padding: 6rpx 0 10rpx; }
.dp-item {
  width: calc(50% - 16rpx); box-sizing: border-box; margin: 8rpx 8rpx;
  text-align: center; font-size: 29rpx; color: #1a2233; background: #f2f5fa;
  border-radius: 14rpx; line-height: 92rpx;
}
.dp-item:active { background: #e7eefb; }

.quick-bar { white-space: nowrap; padding: 12rpx 16rpx; background: #f5f6f8; }
.quick-chip {
  display: inline-block; font-size: 26rpx; color: #1a73e8;
  background: #fff; border: 1rpx solid #d4e2fc;
  padding: 10rpx 22rpx; border-radius: 30rpx; margin-right: 14rpx;
}

.input-bar {
  display: flex; align-items: center; padding: 16rpx 24rpx;
  background: #fff; border-top: 1rpx solid #eee;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}
.input {
  flex: 1; background: #f0f1f3; border-radius: 36rpx;
  padding: 18rpx 28rpx; font-size: 30rpx;
}
.send-btn {
  margin-left: 16rpx; background: #1a73e8; color: #fff;
  font-size: 28rpx; border-radius: 36rpx; padding: 0 36rpx; line-height: 72rpx;
}
.send-btn[disabled] { background: #a9c4f5; }
