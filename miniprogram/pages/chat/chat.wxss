.chat-container { display: flex; flex-direction: column; height: 100vh; box-sizing: border-box; }

/* 当前模型条 */
.model-bar {
  display: flex; align-items: center; background: #fff;
  padding: 18rpx 28rpx; border-bottom: 1rpx solid #eef1f5;
}
.mb-dot { font-size: 28rpx; margin-right: 12rpx; }
.mb-name { flex: 1; font-size: 26rpx; color: #24324a; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.mb-switch { font-size: 24rpx; color: #1a73e8; }

.msg-list { flex: 1; padding: 20rpx 0; overflow: hidden; }

.msg-row { display: flex; padding: 12rpx 24rpx; }
.msg-row.user { justify-content: flex-end; }
.msg-row.assistant { justify-content: flex-start; }

.bubble { max-width: 78%; padding: 20rpx 24rpx; border-radius: 18rpx; word-break: break-all; }
.bubble.user { background: #1a73e8; }
.bubble.user .bubble-text { color: #fff; }
.bubble.assistant { background: #fff; }
.bubble-text { font-size: 30rpx; line-height: 1.5; white-space: pre-wrap; color: #222; }

.sources { margin-top: 14rpx; display: flex; flex-wrap: wrap; }
.src-tag {
  font-size: 22rpx; color: #1a73e8; background: #eaf1fe;
  padding: 4rpx 14rpx; border-radius: 20rpx; margin: 6rpx 8rpx 0 0;
}

.quick-bar { white-space: nowrap; padding: 12rpx 16rpx; background: #f5f6f8; }
.quick-chip {
  display: inline-block; font-size: 26rpx; color: #1a73e8;
  background: #fff; border: 1rpx solid #d4e2fc;
  padding: 10rpx 22rpx; border-radius: 30rpx; margin-right: 14rpx;
}

.input-bar {
  display: flex; align-items: center; padding: 16rpx 24rpx;
  background: #fff; border-top: 1rpx solid #eee;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}
.input {
  flex: 1; background: #f0f1f3; border-radius: 36rpx;
  padding: 18rpx 28rpx; font-size: 30rpx;
}
.send-btn {
  margin-left: 16rpx; background: #1a73e8; color: #fff;
  font-size: 28rpx; border-radius: 36rpx; padding: 0 36rpx; line-height: 72rpx;
}
.send-btn[disabled] { background: #a9c4f5; }
