<view class="container">
  <!-- 总览 -->
  <view class="card hero">
    <block wx:if="{{gpa}}">
      <view class="hero-top">
        <view class="hero-left">
          <text class="hero-label">平均绩点</text>
          <view class="hero-num"><text class="hero-gpa">{{gpa}}</text><text class="hero-max">/ 4.0</text></view>
        </view>
        <view class="hero-badge tone-{{gpaLevel == '优秀' ? 'a' : (gpaLevel == '良好' ? 'b' : (gpaLevel == '中等' ? 'c' : (gpaLevel == '及格' ? 'd' : 'e')))}}">{{gpaLevel}}</view>
      </view>
      <view class="bar"><view class="bar-in" style="width:{{gpaPct}}%"></view></view>
      <view class="hero-stats">
        <view class="stat"><text class="stat-n">{{avg}}</text><text class="stat-l">加权均分</text></view>
        <view class="stat"><text class="stat-n">{{count}}</text><text class="stat-l">门课程</text></view>
        <view class="stat"><text class="stat-n">{{totalCredit}}</text><text class="stat-l">总学分</text></view>
      </view>
      <view wx:if="{{failed.length}}" class="warn">有 {{failed.length}} 门不及格：{{failed}}，请尽快安排重修</view>
      <view class="ai-btn" bindtap="askAI">让 AI 分析我的成绩，给提升建议</view>
    </block>
    <view wx:else class="empty">
      <text class="empty-t">还没有成绩</text>
      <text class="empty-d">录入学分和分数，这里会显示绩点、等级分布和提分测算</text>
    </view>
  </view>

  <!-- 等级分布 -->
  <view class="card" wx:if="{{dist.length}}">
    <view class="sec-title">成绩分布</view>
    <view class="dist-row" wx:for="{{dist}}" wx:key="text">
      <text class="dist-l">{{item.text}}</text>
      <view class="dist-bar"><view class="dist-in t-{{index}}" style="width:{{item.pct}}%"></view></view>
      <text class="dist-n">{{item.n}}</text>
    </view>
  </view>

  <!-- 提分测算 -->
  <view class="card" wx:if="{{gpa}}">
    <view class="sec-title">提分测算</view>
    <view class="plan-inputs">
      <view class="pi">
        <text class="pi-l">目标绩点</text>
        <input class="pi-i" type="digit" value="{{targetGpa}}" bindinput="onTarget" />
      </view>
      <view class="pi">
        <text class="pi-l">下学期学分</text>
        <input class="pi-i" type="digit" value="{{nextCredits}}" bindinput="onNextCredit" />
      </view>
    </view>
    <view wx:if="{{planText}}" class="plan-out {{planWarn ? 'warn-out' : ''}}">{{planText}}</view>
  </view>

  <!-- 录入 -->
  <view class="card">
    <view class="sec-title">录入成绩</view>
    <view class="form-row">
      <input class="f-input flex2" placeholder="课程名" value="{{name}}" bindinput="onName" />
      <input class="f-input" type="digit" placeholder="学分" value="{{credit}}" bindinput="onCredit" />
      <input class="f-input" type="digit" placeholder="分数" value="{{score}}" bindinput="onScore" />
    </view>
    <button class="btn-primary" bindtap="add">添加</button>
  </view>

  <!-- 课程列表 -->
  <view class="card" wx:if="{{list.length}}">
    <view class="sec-title">课程（按分数排序）</view>
    <view class="row" wx:for="{{list}}" wx:key="idx">
      <view class="r-main">
        <text class="r-name">{{item.name}}</text>
        <text class="r-sub">{{item.credit}} 学分</text>
      </view>
      <text class="r-lv t-{{item.tone}}">{{item.level}}</text>
      <text class="r-score t-{{item.tone}}">{{item.score}}</text>
      <text class="r-del" data-i="{{item.idx}}" bindtap="remove">删</text>
    </view>
  </view>

  <!-- 官网同步的成绩规则 -->
  <view class="card">
    <view class="sec-row">
      <text class="sec-title">学校成绩规则</text>
      <text class="sync-btn" bindtap="openSync">同步官网</text>
    </view>
    <block wx:if="{{rules.length}}">
      <view class="rule" wx:for="{{rules}}" wx:key="id">
        <view class="rule-t">{{item.title}}</view>
        <view class="rule-c" wx:if="{{item.content}}">{{item.content}}</view>
        <view class="rule-d" wx:if="{{item.date}}">{{item.date}}</view>
      </view>
      <view class="sync-note">来自学校官网 · {{ruleTime}}</view>
    </block>
    <view wx:else class="rule-empty">
      还没有同步。填一个官网「学籍/成绩管理」类页面的网址，就能把本校的绩点算法、等级划分、奖学金评定等规则同步进来。
    </view>
  </view>

  <view class="tip">成绩仅保存在你的手机本地，用于算绩点和问答，不上传服务器存储。</view>

  <!-- 同步设置 -->
  <view wx:if="{{srcShow}}" class="mask" bindtap="closeSync">
    <view class="sheet" catchtap="noop">
      <view class="sheet-h">同步「成绩规则」<text class="sheet-x" catchtap="closeSync">✕</text></view>
      <view class="sec-title" style="margin-bottom:16rpx">学校官网网址</view>
      <input class="f-input full" placeholder="https://www.xxx.edu.cn/xxx" value="{{srcUrl}}" bindinput="onSrcUrl" />
      <view class="sync-tip">由后端抓取该页正文，交给 AI 抽取成绩/绩点相关规则并展示；请只同步学校公开发布的信息。</view>

      <!-- 这页没抽到内容时，给出相关栏目建议 -->
      <view wx:if="{{suggest.length}}" class="sug">
        <view class="sug-h">这页只有链接、没有正文。试试这些相关栏目 👇</view>
        <view class="sug-item" wx:for="{{suggest}}" wx:key="url" data-url="{{item.url}}" bindtap="useSuggest">
          <text class="sug-t">{{item.text}}</text>
          <text class="sug-a">›</text>
        </view>
      </view>

      <button class="btn-primary" bindtap="doSync" disabled="{{syncing}}">{{syncing ? '同步中…' : '立即同步'}}</button>
    </view>
  </view>
</view>
