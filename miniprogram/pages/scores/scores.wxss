/* 等级配色：优秀/良好/中等/及格/不及格 */
.t-a { color: #0f9d63; }
.t-b { color: #1a73e8; }
.t-c { color: #d97706; }
.t-d { color: #7c8a9e; }
.t-e { color: #e5484d; }

/* ---------- 总览 ---------- */
.hero { background: linear-gradient(160deg, #2b7cf0 0%, #1a73e8 55%, #4a9bff 100%); }
.hero-top { display: flex; align-items: flex-start; justify-content: space-between; }
.hero-label { font-size: 24rpx; color: rgba(255,255,255,.82); }
.hero-num { display: flex; align-items: baseline; margin-top: 6rpx; }
.hero-gpa { font-size: 76rpx; font-weight: 700; color: #fff; line-height: 1.05; }
.hero-max { font-size: 26rpx; color: rgba(255,255,255,.7); margin-left: 10rpx; }
.hero-badge {
  font-size: 24rpx; color: #fff; background: rgba(255,255,255,.22);
  border-radius: 30rpx; padding: 8rpx 26rpx;
}

.bar { height: 14rpx; border-radius: 8rpx; background: rgba(255,255,255,.25); margin-top: 26rpx; overflow: hidden; }
.bar-in { height: 100%; border-radius: 8rpx; background: #fff; transition: width .4s; }

.hero-stats { display: flex; margin-top: 26rpx; }
.stat { flex: 1; display: flex; flex-direction: column; align-items: center; }
.stat-n { font-size: 34rpx; font-weight: 600; color: #fff; }
.stat-l { font-size: 22rpx; color: rgba(255,255,255,.75); margin-top: 6rpx; }

.warn {
  margin-top: 24rpx; font-size: 25rpx; color: #fff; line-height: 1.6;
  background: rgba(255,80,80,.28); border-radius: 12rpx; padding: 16rpx 20rpx;
}
.ai-btn {
  margin-top: 26rpx; text-align: center; font-size: 27rpx; color: #1a73e8;
  background: #fff; border-radius: 44rpx; line-height: 80rpx; font-weight: 500;
}
.hero .empty { display: flex; flex-direction: column; align-items: center; padding: 20rpx 0 10rpx; }
.empty-t { font-size: 32rpx; color: #fff; font-weight: 600; }
.empty-d { font-size: 24rpx; color: rgba(255,255,255,.8); margin-top: 14rpx; text-align: center; line-height: 1.6; }

/* ---------- 分布 ---------- */
.sec-title { font-size: 30rpx; font-weight: 600; margin-bottom: 20rpx; color: #1a2233; }
.dist-row { display: flex; align-items: center; margin-bottom: 18rpx; }
.dist-l { width: 110rpx; font-size: 25rpx; color: #5a6684; flex-shrink: 0; }
.dist-bar { flex: 1; height: 22rpx; background: #f2f5fa; border-radius: 12rpx; overflow: hidden; }
.dist-in { height: 100%; border-radius: 12rpx; transition: width .4s; }
.dist-in.t-0 { background: #10b981; }
.dist-in.t-1 { background: #1a73e8; }
.dist-in.t-2 { background: #f59e0b; }
.dist-in.t-3 { background: #94a3b8; }
.dist-in.t-4 { background: #ef4444; }
.dist-n { width: 60rpx; text-align: right; font-size: 25rpx; color: #8c98ab; flex-shrink: 0; }

/* ---------- 提分测算 ---------- */
.plan-inputs { display: flex; }
.pi { flex: 1; }
.pi:first-child { margin-right: 20rpx; }
.pi-l { display: block; font-size: 24rpx; color: #8c98ab; margin-bottom: 10rpx; }
.pi-i { background: #f2f5fa; border-radius: 10rpx; padding: 16rpx 20rpx; font-size: 28rpx; }
.plan-out {
  margin-top: 22rpx; font-size: 26rpx; line-height: 1.65; color: #1a2b45;
  background: #eaf1fe; border-radius: 12rpx; padding: 18rpx 22rpx;
}
.plan-out.warn-out { background: #fff2f2; color: #b42318; }

/* ---------- 录入 ---------- */
.form-row { display: flex; margin-bottom: 20rpx; }
.f-input { flex: 1; background: #f0f1f3; border-radius: 10rpx; padding: 16rpx 20rpx; font-size: 28rpx; margin-right: 12rpx; }
.f-input.flex2 { flex: 2; }
.form-row .f-input:last-child { margin-right: 0; }

/* ---------- 课程列表 ---------- */
.row { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #f2f4f8; }
.row:last-child { border-bottom: none; }
.r-main { flex: 1; min-width: 0; }
.r-name { display: block; font-size: 29rpx; color: #1a2233; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.r-sub { display: block; font-size: 22rpx; color: #9aa6b5; margin-top: 6rpx; }
.r-lv { font-size: 22rpx; border-radius: 6rpx; padding: 4rpx 12rpx; background: #f2f5fa; margin-right: 16rpx; }
.r-score { font-size: 34rpx; font-weight: 700; width: 76rpx; text-align: right; }
.r-del { font-size: 22rpx; color: #c6d0de; padding: 8rpx 0 8rpx 20rpx; }

.tip { font-size: 24rpx; color: #aaa; text-align: center; margin: 24rpx; }
