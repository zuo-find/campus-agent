.container { padding-bottom: 40rpx; }

/* ---------- 头部 ---------- */
.hero {
  background: linear-gradient(160deg, #2b7cf0 0%, #1a73e8 55%, #4a9bff 100%);
  padding: 56rpx 40rpx 92rpx;
  display: flex; flex-direction: column; align-items: center;
}
.hero-logo {
  width: 128rpx; height: 128rpx; border-radius: 36rpx; background: #fff;
  padding: 14rpx; box-sizing: border-box; margin-bottom: 24rpx;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(12,46,110,.2);
}
.hero-logo-img { width: 100%; height: 100%; display: block; border-radius: 24rpx; }
.hero-name { font-size: 42rpx; font-weight: 700; color: #fff; letter-spacing: 3rpx; }
.hero-tag {
  font-size: 25rpx; color: rgba(255,255,255,.86); line-height: 1.6;
  margin-top: 14rpx; text-align: center;
}
.hero-ver {
  font-size: 22rpx; color: #fff; background: rgba(255,255,255,.22);
  border-radius: 24rpx; padding: 6rpx 24rpx; margin-top: 24rpx;
}

/* ---------- 通用 ---------- */
.grp-t { font-size: 26rpx; color: #8c98ab; margin: 30rpx 40rpx 0; }
.sec-title { font-size: 30rpx; font-weight: 600; color: #1a2233; margin-bottom: 16rpx; }
.para {
  display: block; font-size: 27rpx; color: #5a6684; line-height: 1.8;
  margin-top: 14rpx; text-align: justify;
}

/* ---------- 痛点 ---------- */
.pain { padding: 20rpx 0; border-bottom: 1rpx solid #f2f4f8; }
.pain:first-child { padding-top: 0; }
.pain:last-child { border-bottom: none; padding-bottom: 0; }
.pain-t { display: block; font-size: 28rpx; font-weight: 600; color: #1a2233; }
.pain-d { display: block; font-size: 25rpx; color: #6a7689; line-height: 1.75; margin-top: 8rpx; }

/* ---------- 功能 ---------- */
.f-g { display: block; font-size: 28rpx; font-weight: 600; color: #1a73e8; margin-bottom: 12rpx; }
.f-item { display: flex; align-items: flex-start; padding: 8rpx 0; }
.f-dot {
  width: 10rpx; height: 10rpx; border-radius: 50%; background: #c6d0de;
  margin: 14rpx 16rpx 0 0; flex-shrink: 0;
}
.f-t { flex: 1; font-size: 25rpx; color: #5a6684; line-height: 1.7; }

/* ---------- 技术分层 ---------- */
.layer { padding: 18rpx 0; border-bottom: 1rpx solid #f2f4f8; }
.layer:first-child { padding-top: 0; }
.layer:last-child { border-bottom: none; padding-bottom: 0; }
.layer-n {
  display: inline-block; font-size: 23rpx; color: #1a73e8; background: #eaf1fe;
  border-radius: 6rpx; padding: 4rpx 14rpx;
}
.layer-d { display: block; font-size: 25rpx; color: #5a6684; line-height: 1.75; margin-top: 10rpx; }

/* ---------- 亮点 ---------- */
.hl { display: flex; margin-bottom: 24rpx; }
.hl:last-child { margin-bottom: 0; }
.hl-no {
  width: 36rpx; height: 36rpx; flex-shrink: 0; margin-right: 16rpx; margin-top: 2rpx;
  font-size: 22rpx; color: #fff; background: #1a73e8; border-radius: 50%;
  text-align: center; line-height: 36rpx;
}
.hl-c { flex: 1; min-width: 0; }
.hl-t { display: block; font-size: 27rpx; font-weight: 600; color: #1a2233; }
.hl-d { display: block; font-size: 24rpx; color: #6a7689; line-height: 1.75; margin-top: 6rpx; }

/* ---------- 参赛信息 ---------- */
.kv { display: flex; padding: 16rpx 0; border-bottom: 1rpx solid #f2f4f8; }
.kv:last-child { border-bottom: none; }
.kv-k { width: 160rpx; flex-shrink: 0; font-size: 26rpx; color: #8c98ab; }
.kv-v { flex: 1; font-size: 26rpx; color: #1a2233; line-height: 1.5; }
.kv-v.todo { color: #d97706; }

/* ---------- 说明 ---------- */
.cmp { padding: 18rpx 0; border-bottom: 1rpx solid #f2f4f8; }
.cmp:first-child { padding-top: 0; }
.cmp:last-child { border-bottom: none; padding-bottom: 0; }
.cmp-t { display: block; font-size: 27rpx; font-weight: 600; color: #1a2233; }
.cmp-d { display: block; font-size: 24rpx; color: #6a7689; line-height: 1.75; margin-top: 6rpx; }

.foot { text-align: center; font-size: 22rpx; color: #b6c0cf; margin: 56rpx 0 20rpx; }
