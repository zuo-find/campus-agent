.container { padding-bottom: 40rpx; }

.seg { display: flex; background: #fff; margin: 20rpx 24rpx; border-radius: 12rpx; padding: 6rpx; }
.seg.small { margin: 0; flex: 1; }
.seg-item { flex: 1; text-align: center; font-size: 28rpx; color: #666; padding: 16rpx 0; border-radius: 10rpx; }
.seg-item.on { background: #1a73e8; color: #fff; }

.muted { color: #999; font-size: 26rpx; }
.center { text-align: center; margin: 40rpx 0; }

.weather-card { background: linear-gradient(135deg, #1a73e8, #4a9bff); color: #fff; }
.w-top { display: flex; align-items: center; }
.w-temp { font-size: 76rpx; font-weight: 300; margin-right: 24rpx; }
.w-meta { display: flex; flex-direction: column; }
.w-city { font-size: 30rpx; }
.w-range { font-size: 24rpx; opacity: .85; margin-top: 6rpx; }
.weather-card .advice { background: rgba(255,255,255,.18); }

.advice { margin-top: 20rpx; background: #eaf1fe; color: #1a2b45; border-radius: 12rpx; padding: 18rpx 22rpx; font-size: 28rpx; line-height: 1.5; }

.sec-title { font-size: 30rpx; font-weight: 600; margin-bottom: 18rpx; color: #222; }
.sec-title-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; }
.sec-title-row .sec-title { margin-bottom: 0; }
.sync-btn { font-size: 24rpx; color: #1a73e8; border: 1rpx solid #cfe0fb; border-radius: 30rpx; padding: 6rpx 22rpx; }
.sync-btn:active { background: #eaf1fe; }
.sync-note { font-size: 22rpx; color: #a6b0c0; text-align: right; margin-top: 14rpx; }

.noti { padding: 18rpx 0; border-bottom: 1rpx solid #f2f4f8; }
.noti:last-child { border-bottom: none; }
.noti-t { font-size: 28rpx; color: #1a2233; line-height: 1.5; }
.noti-c { font-size: 24rpx; color: #7c8a9e; margin-top: 8rpx; line-height: 1.6; }
.noti-d { font-size: 22rpx; color: #b6c0cf; margin-top: 8rpx; }

/* 同步设置弹层 */
.mask { position: fixed; inset: 0; background: rgba(16,24,40,.5); z-index: 60; display: flex; align-items: flex-end; }
.sheet { width: 100%; background: #fff; border-radius: 28rpx 28rpx 0 0; padding: 28rpx 32rpx 40rpx; box-sizing: border-box; }
.sheet-h { position: relative; text-align: center; font-size: 32rpx; font-weight: 600; color: #1a2233; padding-bottom: 20rpx; }
.sheet-x { position: absolute; right: 0; top: 0; font-size: 30rpx; color: #a6b0c0; padding: 0 8rpx; }
.sheet-body { max-height: 900rpx; }
.cat-pick { display: flex; }
.cat-opt { flex: 1; text-align: center; font-size: 27rpx; color: #5a6684; background: #f2f5fa;
  border-radius: 12rpx; line-height: 76rpx; margin-right: 14rpx; }
.cat-opt:last-child { margin-right: 0; }
.cat-opt.on { background: #1a73e8; color: #fff; font-weight: 500; }
.sync-tip { font-size: 22rpx; color: #9aa6b5; line-height: 1.6; margin: 6rpx 0 22rpx; }

/* ---------- 我的课表 ---------- */
.tt-day { padding: 6rpx 0; }
.tt-day-h { display: flex; align-items: center; margin-top: 14rpx; }
.tt-day-n { font-size: 24rpx; color: #8c98ab; }
.tt-day-n.today { color: #1a73e8; font-weight: 600; }
.tt-today {
  font-size: 19rpx; color: #fff; background: #1a73e8; border-radius: 6rpx;
  padding: 2rpx 10rpx; margin-left: 10rpx;
}
.tt-row { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #f2f4f8; }
.tt-row:last-child { border-bottom: none; }
.tt-main { flex: 1; min-width: 0; }
.tt-n { display: block; font-size: 29rpx; color: #1a2233; }
.tt-t { display: block; font-size: 23rpx; color: #8c98ab; margin-top: 6rpx; }
/* 删除：垃圾桶图标（图片资源，比手画的线条稳） */
.tt-del { padding: 16rpx 0 16rpx 24rpx; }
.tt-del-img { width: 44rpx; height: 44rpx; display: block; opacity: .8; }
.tt-del-hover .tt-del-img { opacity: 1; }

.tt-empty { padding: 20rpx 0 10rpx; }
.tt-empty-t { display: block; font-size: 28rpx; color: #5a6684; }
.tt-empty-d { display: block; font-size: 23rpx; color: #9aa6b5; line-height: 1.7; margin-top: 8rpx; }

/* 导入方式 */
.way { padding: 22rpx 0; border-bottom: 1rpx solid #f2f4f8; }
.way:last-of-type { border-bottom: none; }
.way-t { display: block; font-size: 29rpx; color: #1a2233; }
.way-d { display: block; font-size: 23rpx; color: #9aa6b5; line-height: 1.6; margin-top: 6rpx; }

/* 识别结果确认 */
.tt-confirm-body { max-height: 640rpx; }
.tt-confirm { display: flex; align-items: center; padding: 18rpx 0; border-bottom: 1rpx solid #f2f4f8; }
.cb {
  width: 34rpx; height: 34rpx; border-radius: 50%; border: 2rpx solid #c6d0de;
  margin-right: 18rpx; flex-shrink: 0; box-sizing: border-box;
  display: flex; align-items: center; justify-content: center;
  font-size: 21rpx; color: #fff;
}
.cb.on { background: #1a73e8; border-color: #1a73e8; }
.tt-confirm-main { flex: 1; min-width: 0; }

/* 手动添加课程 */
.mf-body { max-height: 760rpx; }
.mf-label { font-size: 24rpx; color: #8c98ab; margin: 6rpx 0 12rpx; }
.mf-chips { display: flex; flex-wrap: wrap; margin-bottom: 20rpx; }
.mf-chip {
  font-size: 26rpx; color: #5a6684; background: #f2f5fa; border-radius: 10rpx;
  padding: 14rpx 0; text-align: center; margin: 0 12rpx 12rpx 0; flex: 1; min-width: 78rpx;
}
.mf-chip.on { background: #1a73e8; color: #fff; font-weight: 500; }
.mf-chip.period { min-width: 120rpx; padding: 10rpx 0; }
.mf-chip-t { display: block; font-size: 24rpx; }
.mf-chip-s { display: block; font-size: 19rpx; opacity: .7; margin-top: 4rpx; }
.mf-places { display: flex; flex-wrap: wrap; margin: -4rpx 0 16rpx; }
.mf-place {
  font-size: 22rpx; color: #1a73e8; border: 1rpx solid #d4e2fc; border-radius: 24rpx;
  padding: 6rpx 18rpx; margin: 8rpx 12rpx 0 0;
}
.mf-dup {
  font-size: 23rpx; color: #b42318; background: #fff2f2; border-radius: 10rpx;
  padding: 14rpx 18rpx; line-height: 1.6; margin-bottom: 10rpx;
}
.mf-btns { display: flex; padding-top: 8rpx; }
.mf-btn { flex: 1; font-size: 28rpx; line-height: 84rpx; border-radius: 42rpx; padding: 0; }
.mf-btn.ghost { color: #5a6b82; background: #fff; border: 1rpx solid #d7dee9; margin-right: 20rpx; }
.mf-btn.primary { color: #fff; background: #1a73e8; }

/* 选择学校：输入校名 → 点一条自动填网址 */
.uni-list { background: #f7f9fd; border-radius: 12rpx; margin-bottom: 4rpx; overflow: hidden; }
.uni-item { display: flex; align-items: center; padding: 18rpx 20rpx; border-bottom: 1rpx solid #eef2f8; }
.uni-item:last-child { border-bottom: none; }
.uni-item:active { background: #eaf1fe; }
.uni-main { flex: 1; min-width: 0; }
.uni-n { font-size: 26rpx; color: #1a2233; }
.uni-p { font-size: 22rpx; color: #9aa6b5; margin-left: 12rpx; }
.uni-u { font-size: 22rpx; color: #1a73e8; flex-shrink: 0; margin-left: 12rpx; }

/* ---------- 同步完成的学校 logo 过场动画 ---------- */
.logo-mask {
  position: fixed; inset: 0; z-index: 90;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  background: rgba(255,255,255,.96);
  animation: maskIn .28s ease both;
}
@keyframes maskIn { from { opacity: 0; } to { opacity: 1; } }

.logo-wrap { position: relative; display: flex; align-items: center; justify-content: center; }
.ring {
  position: absolute; width: 190rpx; height: 190rpx; border-radius: 50%;
  border: 3rpx solid rgba(26,115,232,.4);
  animation: ringOut 1.4s cubic-bezier(.2,.7,.3,1) .1s both;
}
@keyframes ringOut { 0% { opacity: .9; transform: scale(.9); } 100% { opacity: 0; transform: scale(2.1); } }

.logo-img {
  /* 用宽一些的框，横版校徽(如 425x72)也能完整显示 */
  width: 380rpx; height: 190rpx; border-radius: 28rpx; background: #fff;
  box-shadow: 0 18rpx 50rpx rgba(24,39,75,.16);
  animation: logoIn .65s cubic-bezier(.2,.9,.3,1.25) both;
}
/* 浅色(白色)校徽：垫品牌蓝底，否则白底白图看不见 */
.logo-img.light { background: linear-gradient(150deg, #2b7cf0, #1a73e8); }
.logo-wrap.on-dark .ring { border-color: rgba(26,115,232,.35); }
@keyframes logoIn {
  from { opacity: 0; transform: scale(.55) translateY(30rpx); }
  to   { opacity: 1; transform: scale(1) translateY(0); }
}
.logo-ph {
  width: 176rpx; height: 176rpx; border-radius: 36rpx; background: linear-gradient(150deg,#4a9bff,#1a73e8);
  color: #fff; font-size: 72rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 18rpx 50rpx rgba(24,39,75,.16);
  animation: logoIn .65s cubic-bezier(.2,.9,.3,1.25) both;
}

.logo-name {
  margin-top: 40rpx; font-size: 34rpx; font-weight: 600; color: #1a2233; letter-spacing: 1rpx;
  animation: fadeUp .5s ease .35s both;
}
.logo-ok {
  margin-top: 26rpx; display: flex; align-items: center;
  animation: fadeUp .5s ease .55s both;
}
.ok-check {
  width: 26rpx; height: 14rpx; border-left: 4rpx solid #0f9d63; border-bottom: 4rpx solid #0f9d63;
  transform: rotate(-45deg); margin-right: 14rpx;
}
.ok-t { font-size: 26rpx; color: #0f9d63; }
@keyframes fadeUp { from { opacity: 0; transform: translateY(16rpx); } to { opacity: 1; transform: translateY(0); } }
.row { display: flex; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid #f2f2f2; font-size: 28rpx; }
.row:last-child { border-bottom: none; }
.row-l { color: #333; }
.row-r { color: #888; }

.f-input { background: #f0f1f3; border-radius: 10rpx; padding: 18rpx 20rpx; font-size: 28rpx; margin-bottom: 16rpx; }
.picker { background: #f0f1f3; border-radius: 10rpx; padding: 18rpx 20rpx; font-size: 28rpx; color: #555; margin-bottom: 16rpx; }
.f-area { width: 100%; box-sizing: border-box; background: #f0f1f3; border-radius: 10rpx; padding: 20rpx; font-size: 28rpx; height: 160rpx; margin-bottom: 16rpx; }

/* ---------- 二手市场 ---------- */
.cat-bar { white-space: nowrap; padding: 18rpx 16rpx 6rpx; }
.cat-chip { display: inline-block; font-size: 26rpx; color: #5a6684; background: #fff; border-radius: 30rpx;
  padding: 10rpx 26rpx; margin-right: 14rpx; border: 1rpx solid #e6ebf3; }
.cat-chip.on { background: #1a73e8; color: #fff; border-color: #1a73e8; font-weight: 500; }

.mk-hint { font-size: 22rpx; color: #a6b0c0; margin: 12rpx 28rpx 4rpx; }

.mk-grid { display: flex; flex-wrap: wrap; padding: 6rpx 18rpx 140rpx; }
.mk-card { width: calc(50% - 18rpx); margin: 9rpx; background: #fff; border-radius: 18rpx; overflow: hidden;
  box-shadow: 0 6rpx 20rpx rgba(24,39,75,.06); }
.mk-thumb { position: relative; width: 100%; height: 330rpx; background: #eef1f6; }
.mk-img { width: 100%; height: 100%; display: block; }
.mk-ph { width: 100%; height: 100%; color: #fff; font-size: 26rpx; display: flex; align-items: center; justify-content: center; opacity: .82; }
.mk-sold { position: absolute; left: 0; top: 0; background: rgba(0,0,0,.55); color: #fff; font-size: 22rpx; padding: 6rpx 18rpx; border-radius: 0 0 14rpx 0; }
.mk-body { padding: 16rpx 18rpx 20rpx; }
.mk-title { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  font-size: 27rpx; color: #1a2233; line-height: 1.4; height: 76rpx; }
.mk-prow { display: flex; align-items: baseline; margin-top: 12rpx; }
.mk-yen { color: #ff4d4f; font-size: 22rpx; font-weight: 600; }
.mk-price { color: #ff4d4f; font-size: 36rpx; font-weight: 700; margin-left: 2rpx; }
.mk-orig { color: #b6c0cf; font-size: 22rpx; text-decoration: line-through; margin-left: 12rpx; }
.mk-mm { display: flex; justify-content: space-between; align-items: center; margin-top: 12rpx; }
.mk-cat { font-size: 20rpx; color: #8c98ab; background: #f2f5fa; border-radius: 8rpx; padding: 4rpx 12rpx; }
.mk-t { font-size: 20rpx; color: #b6c0cf; }

.mk-fab { position: fixed; right: 40rpx; bottom: 60rpx; width: 104rpx; height: 104rpx; border-radius: 50%;
  background: linear-gradient(135deg,#4a9bff,#1a73e8); color: #fff; font-size: 60rpx; font-weight: 300;
  display: flex; align-items: center; justify-content: center; box-shadow: 0 12rpx 28rpx rgba(26,115,232,.4); z-index: 20; }

/* 弹出层（发布 / 详情） */
.mk-sheet-mask { position: fixed; inset: 0; background: rgba(16,24,40,.5); z-index: 50; display: flex; align-items: flex-end; }
.mk-sheet { width: 100%; background: #fff; border-radius: 28rpx 28rpx 0 0; padding: 28rpx 32rpx 40rpx; box-sizing: border-box; }
.sheet-h { position: relative; text-align: center; font-size: 32rpx; font-weight: 600; color: #1a2233; padding-bottom: 20rpx; }
.sheet-x { position: absolute; right: 0; top: 0; font-size: 30rpx; color: #a6b0c0; padding: 0 8rpx; }
.sheet-body { max-height: 900rpx; }
.mk-price-row { display: flex; }
.f-input.half { flex: 1; }
.f-input.half:first-child { margin-right: 16rpx; }

.img-picker { display: flex; flex-wrap: wrap; margin: 6rpx 0 22rpx; }
.img-item { position: relative; width: 180rpx; height: 180rpx; margin: 0 16rpx 16rpx 0; border-radius: 12rpx; overflow: hidden; }
.img-thumb { width: 100%; height: 100%; }
.img-del { position: absolute; right: 0; top: 0; width: 40rpx; height: 40rpx; background: rgba(0,0,0,.55);
  color: #fff; font-size: 24rpx; display: flex; align-items: center; justify-content: center; border-radius: 0 0 0 12rpx; }
.img-add { width: 180rpx; height: 180rpx; border: 2rpx dashed #cfd8e6; border-radius: 12rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center; color: #9aa6b5; }
.img-add-plus { font-size: 46rpx; line-height: 1; }
.img-add-t { font-size: 22rpx; margin-top: 8rpx; }

/* 详情 */
.mk-detail { width: 100%; background: #fff; border-radius: 28rpx 28rpx 0 0; padding-bottom: 40rpx; box-sizing: border-box; }
.d-swiper { width: 100%; height: 560rpx; background: #eef1f6; }
.d-img { width: 100%; height: 100%; }
.d-ph { width: 100%; height: 400rpx; color: #fff; font-size: 34rpx; display: flex; align-items: center; justify-content: center; opacity: .85; }
.d-body { padding: 28rpx 32rpx 8rpx; }
.d-prow { display: flex; align-items: baseline; }
.d-yen { color: #ff4d4f; font-size: 30rpx; font-weight: 600; }
.d-price { color: #ff4d4f; font-size: 56rpx; font-weight: 700; margin-left: 4rpx; }
.d-orig { color: #b6c0cf; font-size: 24rpx; text-decoration: line-through; margin-left: 18rpx; }
.d-title { display: block; font-size: 34rpx; font-weight: 600; color: #1a2233; margin-top: 16rpx; line-height: 1.4; }
.d-tags { margin-top: 14rpx; }
.d-tag { font-size: 22rpx; color: #5a6684; background: #f2f5fa; border-radius: 8rpx; padding: 6rpx 16rpx; margin-right: 12rpx; }
.d-detail { display: block; font-size: 27rpx; color: #5a6684; line-height: 1.7; margin-top: 20rpx; }
.d-seller { font-size: 25rpx; color: #46536b; background: #f7f9fd; border-radius: 12rpx; padding: 18rpx 22rpx; margin-top: 22rpx; }
.d-btns { display: flex; padding: 24rpx 32rpx 0; }
.flex1 { flex: 1; }
.btn-ghost { background: #fff; color: #5a6b82; border: 1rpx solid #d7dee9; border-radius: 48rpx; font-size: 29rpx;
  line-height: 88rpx; margin: 0 14rpx 0 0; }
.d-close { display: block; text-align: center; font-size: 26rpx; color: #a6b0c0; margin-top: 26rpx; }

/* ---------- 失物招领 ---------- */
.lf-head { display: flex; align-items: center; margin: 20rpx 24rpx; }
.mini-btn {
  font-size: 26rpx; color: #fff; background: #1a73e8; border: none;
  border-radius: 36rpx; line-height: 68rpx; padding: 0 34rpx; margin-left: 16rpx;
  box-shadow: 0 8rpx 18rpx rgba(26,115,232,.26);
}

/* 卡片：左侧类型色条 + 内容区 */
.lf-card {
  position: relative; display: flex; background: #fff; border-radius: 20rpx;
  margin: 0 24rpx 22rpx; overflow: hidden;
  box-shadow: 0 8rpx 26rpx rgba(24,39,75,.06);
}
.lf-accent { width: 8rpx; flex-shrink: 0; }
.lf-card.lost  .lf-accent { background: linear-gradient(180deg,#ff7a7f,#ff5a5f); }
.lf-card.found .lf-accent { background: linear-gradient(180deg,#34d399,#10b981); }

.lf-body { flex: 1; padding: 28rpx 30rpx 24rpx; min-width: 0; }

.lf-top { display: flex; align-items: center; }
.lf-badge { font-size: 22rpx; padding: 5rpx 16rpx; border-radius: 8rpx; margin-right: 16rpx; flex-shrink: 0; }
.lf-card.lost  .lf-badge { background: #ffeceb; color: #e5484d; }
.lf-card.found .lf-badge { background: #e6f8f0; color: #0f9d63; }
.lf-title { flex: 1; font-size: 32rpx; font-weight: 600; color: #1a2233; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.lf-time { font-size: 22rpx; color: #a6b0c0; margin-left: 14rpx; flex-shrink: 0; }

.lf-meta { display: flex; font-size: 26rpx; margin-top: 12rpx; }
.lf-k { width: 68rpx; color: #a6b0c0; flex-shrink: 0; }
.lf-v { flex: 1; color: #5a6684; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

.lf-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 22rpx; }
.lf-contact { background: #f1f5fb; border-radius: 10rpx; padding: 10rpx 20rpx; font-size: 24rpx; color: #46536b; max-width: 70%; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.lf-contact-t { color: #64708a; }
.lf-done { font-size: 24rpx; color: #1a73e8; border: 1rpx solid #cfe0fb; border-radius: 30rpx; padding: 8rpx 26rpx; }

/* 空状态 */
.lf-empty { display: flex; flex-direction: column; align-items: center; padding: 110rpx 48rpx; }
.empty-mark {
  width: 128rpx; height: 128rpx; border-radius: 50%;
  background: linear-gradient(135deg,#eef3fb,#dfe9f8);
  border: 4rpx solid #e7eefb; margin-bottom: 30rpx; position: relative;
}
.empty-mark::after {
  content: ''; position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%);
  width: 46rpx; height: 46rpx; border: 5rpx dashed #b9c9e6; border-radius: 12rpx;
}
.empty-t { font-size: 30rpx; color: #4a5771; font-weight: 600; }
.empty-d { font-size: 24rpx; color: #a6b0c0; margin-top: 14rpx; text-align: center; line-height: 1.6; }

.tip { font-size: 24rpx; color: #aaa; text-align: center; margin: 24rpx; }
