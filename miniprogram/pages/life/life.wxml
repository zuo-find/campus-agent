<view class="container">
  <!-- 顶部功能切换 -->
  <view class="seg">
    <view class="seg-item {{tab=='home'?'on':''}}" data-tab="home" bindtap="switchTab">天气·校历</view>
    <view class="seg-item {{tab=='errand'?'on':''}}" data-tab="errand" bindtap="switchTab">快递外卖</view>
    <view class="seg-item {{tab=='lost'?'on':''}}" data-tab="lost" bindtap="switchTab">失物招领</view>
    <view class="seg-item {{tab=='market'?'on':''}}" data-tab="market" bindtap="switchTab">二手市场</view>
  </view>

  <!-- ============ 天气 + 校历作息 ============ -->
  <block wx:if="{{tab=='home'}}">
    <view class="card weather-card">
      <view wx:if="{{wLoading}}" class="muted">天气加载中…</view>
      <block wx:elif="{{weather}}">
        <view class="w-top">
          <text class="w-temp">{{weather.temp}}°</text>
          <view class="w-meta">
            <text class="w-city">{{weather.city}} · {{weather.desc}}</text>
            <text class="w-range">{{weather.temp_min}}° ~ {{weather.temp_max}}° · 降水{{weather.rain_prob}}%</text>
          </view>
        </view>
        <view class="advice">{{advice}}</view>
      </block>
      <view wx:else class="muted">{{advice}}</view>
    </view>

    <view class="card">
      <view class="sec-title">作息时间</view>
      <view class="row" wx:for="{{schedule}}" wx:key="period">
        <text class="row-l">{{item.period}}</text><text class="row-r">{{item.time}}</text>
      </view>
    </view>

    <view class="card">
      <view class="sec-title">校历速查</view>
      <view class="row" wx:for="{{calendar}}" wx:key="label">
        <text class="row-l">{{item.label}}</text><text class="row-r">{{item.date}}</text>
      </view>
    </view>
  </block>

  <!-- ============ 快递外卖（跳转第三方小程序） ============ -->
  <block wx:if="{{tab=='errand'}}">
    <view class="jump-card" wx:for="{{jumps}}" wx:key="key" data-key="{{item.key}}" bindtap="jumpTo">
      <view class="jump-badge tone{{item.tone}}">{{item.initial}}</view>
      <view class="jump-main"><text class="jump-title">{{item.name}}</text><text class="jump-sub">{{item.sub}}</text></view>
      <text class="jump-arrow">›</text>
    </view>

    <!-- 未接入的快递入口（可由管理员在 life.js 的 JUMP 中配置后自动出现） -->
    <view class="jump-card ghost">
      <view class="jump-badge ghost-mark">＋</view>
      <view class="jump-main"><text class="jump-title">快递代取 / 收寄</text><text class="jump-sub">暂未接入，可由管理员配置</text></view>
    </view>

    <view class="tip">点击卡片跳转到对应小程序。</view>
  </block>

  <!-- 小程序码弹层（备选跳转方案：长按识别） -->
  <view wx:if="{{qrShow}}" class="qr-mask" bindtap="closeQr">
    <view class="qr-box" catchtap="previewQr">
      <text class="qr-name">{{qrName}}</text>
      <image class="qr-img" src="{{qrSrc}}" mode="widthFix" show-menu-by-longpress />
      <text class="qr-hint">长按图片「识别小程序码」进入<br/>（点图可放大）</text>
      <text class="qr-close" catchtap="closeQr">关闭</text>
    </view>
  </view>

  <!-- ============ 二手市场 ============ -->
  <block wx:if="{{tab=='market'}}">
    <scroll-view class="cat-bar" scroll-x>
      <view class="cat-chip {{cat==item?'on':''}}" wx:for="{{cats}}" wx:key="*this" data-cat="{{item}}" bindtap="pickCat">{{item}}</view>
    </scroll-view>

    <view class="mk-hint">校园闲置交易 · 图片由卖家上传，交易请当面验货</view>

    <view wx:if="{{goodsLoading}}" class="muted center">加载中…</view>

    <view class="mk-grid" wx:if="{{goods.length}}">
      <view class="mk-card" wx:for="{{goods}}" wx:key="id" data-id="{{item.id}}" bindtap="openItem">
        <view class="mk-thumb">
          <image wx:if="{{item.coverUrl}}" class="mk-img" src="{{item.coverUrl}}" mode="aspectFill" />
          <view wx:else class="mk-ph" style="background:{{item.catColor}}">{{item.category}}</view>
          <view class="mk-sold" wx:if="{{item.status=='sold'}}">已售出</view>
        </view>
        <view class="mk-body">
          <text class="mk-title">{{item.title}}</text>
          <view class="mk-prow">
            <text class="mk-yen">¥</text><text class="mk-price">{{item.price}}</text>
            <text class="mk-orig" wx:if="{{item.orig_price}}">¥{{item.orig_price}}</text>
          </view>
          <view class="mk-mm">
            <text class="mk-cat">{{item.category}}</text>
            <text class="mk-t">{{item.timeText}}</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{!goodsLoading && !goods.length}}" class="lf-empty">
      <view class="empty-mark"></view>
      <text class="empty-t">还没有宝贝</text>
      <text class="empty-d">点右下角「＋」，发布你的第一个闲置</text>
    </view>

    <view class="mk-fab" bindtap="toggleSell">＋</view>

    <!-- 发布表单 -->
    <view class="mk-sheet-mask" wx:if="{{sellShow}}" bindtap="toggleSell">
      <view class="mk-sheet" catchtap="noop">
        <view class="sheet-h">发布闲置<text class="sheet-x" catchtap="toggleSell">✕</text></view>
        <scroll-view class="sheet-body" scroll-y>
          <input class="f-input" placeholder="宝贝标题，如 高等数学教材（上册）" value="{{gTitle}}" bindinput="onGTitle" />
          <view class="mk-price-row">
            <input class="f-input half" type="digit" placeholder="售价 ¥" value="{{gPrice}}" bindinput="onGPrice" />
            <input class="f-input half" type="digit" placeholder="原价 ¥（选填）" value="{{gOrig}}" bindinput="onGOrig" />
          </view>
          <picker range="{{cats}}" value="{{gCatIdx}}" bindchange="onGCat">
            <view class="picker">分类：{{cats[gCatIdx]}}</view>
          </picker>
          <textarea class="f-area" placeholder="描述一下成色、来源、可议价等" value="{{gDetail}}" bindinput="onGDetail" maxlength="300" />
          <input class="f-input" placeholder="联系方式（微信/手机号）" value="{{gContact}}" bindinput="onGContact" />

          <view class="img-picker">
            <view class="img-item" wx:for="{{gImages}}" wx:key="*this">
              <image class="img-thumb" src="{{item}}" mode="aspectFill" />
              <view class="img-del" data-i="{{index}}" catchtap="removeImage">✕</view>
            </view>
            <view class="img-add" wx:if="{{gImages.length < 3}}" bindtap="chooseImages">
              <text class="img-add-plus">＋</text><text class="img-add-t">添加图片</text>
            </view>
          </view>

          <button class="btn-primary" bindtap="submitItem" disabled="{{uploading}}">{{uploading ? '发布中…' : '发布'}}</button>
        </scroll-view>
      </view>
    </view>

    <!-- 商品详情弹层 -->
    <view class="mk-sheet-mask" wx:if="{{cur}}" bindtap="closeItem">
      <view class="mk-detail" catchtap="noop">
        <swiper wx:if="{{cur.imgUrls.length}}" class="d-swiper" indicator-dots circular>
          <swiper-item wx:for="{{cur.imgUrls}}" wx:key="*this">
            <image class="d-img" src="{{item}}" mode="aspectFill" />
          </swiper-item>
        </swiper>
        <view wx:else class="d-ph" style="background:{{cur.catColor}}">{{cur.category}}</view>

        <view class="d-body">
          <view class="d-prow">
            <text class="d-yen">¥</text><text class="d-price">{{cur.price}}</text>
            <text class="d-orig" wx:if="{{cur.orig_price}}">原价 ¥{{cur.orig_price}}</text>
          </view>
          <text class="d-title">{{cur.title}}</text>
          <view class="d-tags"><text class="d-tag">{{cur.category}}</text><text class="d-tag" wx:if="{{cur.status=='sold'}}">已售出</text></view>
          <text class="d-detail" wx:if="{{cur.detail}}">{{cur.detail}}</text>
          <view class="d-seller" wx:if="{{cur.contact}}">卖家联系方式：{{cur.contact}}</view>
        </view>

        <view class="d-btns">
          <button class="btn-ghost flex1" bindtap="markSold">标记已售出</button>
          <button class="btn-primary flex1" bindtap="callContact">复制联系方式</button>
        </view>
        <text class="d-close" bindtap="closeItem">关闭</text>
      </view>
    </view>
  </block>

  <!-- ============ 失物招领 ============ -->
  <block wx:if="{{tab=='lost'}}">
    <view class="lf-head">
      <view class="seg small">
        <view class="seg-item {{lfKind=='lost'?'on':''}}" data-k="lost" bindtap="switchLfKind">我丢了</view>
        <view class="seg-item {{lfKind=='found'?'on':''}}" data-k="found" bindtap="switchLfKind">我捡到</view>
      </view>
      <button class="mini-btn" bindtap="toggleForm">{{showForm?'收起':'＋ 发布'}}</button>
    </view>

    <view class="card" wx:if="{{showForm}}">
      <input class="f-input" placeholder="物品，如 黑色雨伞/校园卡" value="{{fTitle}}" bindinput="onFTitle" />
      <input class="f-input" placeholder="地点，如 三教201" value="{{fLocation}}" bindinput="onFLoc" />
      <input class="f-input" placeholder="联系方式" value="{{fContact}}" bindinput="onFContact" />
      <input class="f-input" placeholder="补充描述（可留空）" value="{{fDetail}}" bindinput="onFDetail" />
      <button class="btn-primary" bindtap="submitLf">发布</button>
    </view>

    <view wx:if="{{lfLoading}}" class="muted center">加载中…</view>

    <view class="lf-card {{item.isLost?'lost':'found'}}" wx:for="{{lfList}}" wx:key="id">
      <view class="lf-accent"></view>
      <view class="lf-body">
        <view class="lf-top">
          <text class="lf-badge">{{item.isLost?'丢失':'捡到'}}</text>
          <text class="lf-title">{{item.title}}</text>
          <text class="lf-time">{{item.timeText}}</text>
        </view>
        <view class="lf-meta" wx:if="{{item.location}}"><text class="lf-k">地点</text><text class="lf-v">{{item.location}}</text></view>
        <view class="lf-meta" wx:if="{{item.detail}}"><text class="lf-k">备注</text><text class="lf-v">{{item.detail}}</text></view>
        <view class="lf-foot">
          <view class="lf-contact" wx:if="{{item.contact}}"><text class="lf-contact-t">{{item.contact}}</text></view>
          <view class="lf-done" data-id="{{item.id}}" catchtap="closeLf">标记已解决</view>
        </view>
      </view>
    </view>

    <view wx:if="{{!lfLoading && !lfList.length}}" class="lf-empty">
      <view class="empty-mark"></view>
      <text class="empty-t">这里还空着</text>
      <text class="empty-d">点右上角「＋ 发布」\n说说你丢了或捡到了什么</text>
    </view>
  </block>
</view>
