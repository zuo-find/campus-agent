.container { padding-bottom: 40rpx; }

/* ---------- 头部 ---------- */
.hero {
  background: linear-gradient(160deg, #2b7cf0 0%, #1a73e8 60%, #4a9bff 100%);
  padding: 44rpx 40rpx 52rpx;
}
.hero-t { display: block; font-size: 44rpx; font-weight: 700; color: #fff; }
.hero-d { display: block; font-size: 25rpx; color: rgba(255,255,255,.86); line-height: 1.75; margin-top: 16rpx; }

/* ---------- 目录 ---------- */
.nav { white-space: nowrap; padding: 24rpx 24rpx 4rpx; }
.nav-chip {
  display: inline-block; font-size: 25rpx; color: #1a73e8; background: #eaf1fe;
  border-radius: 30rpx; padding: 12rpx 26rpx; margin-right: 14rpx;
}
.nav-chip:active { background: #d9e6fd; }

.grp-t { font-size: 26rpx; color: #8c98ab; margin: 30rpx 40rpx 0; }

/* ---------- 折叠卡 ---------- */
.g-card { padding: 0; overflow: hidden; }
.g-head { display: flex; align-items: center; padding: 26rpx 28rpx; }
.g-tt { flex: 1; min-width: 0; }
.g-title { display: block; font-size: 30rpx; font-weight: 600; color: #1a2233; }
.g-sub { display: block; font-size: 23rpx; color: #9aa6b5; margin-top: 6rpx; }
.g-arrow { font-size: 34rpx; color: #c6d0de; line-height: 1; transition: transform .2s; transform: rotate(0deg); }
.g-arrow.up { transform: rotate(180deg); }

.g-body { padding: 0 28rpx 26rpx; border-top: 1rpx solid #f2f4f8; }

.step { display: flex; margin-top: 22rpx; }
.step-no {
  width: 34rpx; height: 34rpx; flex-shrink: 0; margin-right: 16rpx; margin-top: 4rpx;
  font-size: 21rpx; color: #fff; background: #1a73e8; border-radius: 50%;
  text-align: center; line-height: 34rpx;
}
.step-c { flex: 1; min-width: 0; }
.step-t { display: block; font-size: 28rpx; font-weight: 600; color: #1a2233; line-height: 1.5; }
.step-d { display: block; font-size: 25rpx; color: #5a6684; line-height: 1.8; margin-top: 8rpx; text-align: justify; }

.g-tip {
  font-size: 24rpx; color: #6b5b1f; background: #fff8e6; border-radius: 12rpx;
  padding: 16rpx 20rpx; line-height: 1.75; margin-top: 24rpx;
}

/* ---------- 常见问题 ---------- */
.q-card { padding: 0 28rpx; }
.q-item { display: flex; align-items: center; padding: 26rpx 0; }
.q-line { border-top: 1rpx solid #f2f4f8; }
.q-mark {
  width: 34rpx; height: 34rpx; flex-shrink: 0; margin-right: 16rpx;
  font-size: 22rpx; font-weight: 700; color: #1a73e8; background: #eaf1fe;
  border-radius: 8rpx; text-align: center; line-height: 34rpx;
}
.q-t { flex: 1; font-size: 27rpx; color: #1a2233; line-height: 1.5; margin-right: 12rpx; }
.q-a {
  font-size: 25rpx; color: #5a6684; line-height: 1.85; background: #f7f9fd;
  border-radius: 12rpx; padding: 20rpx 22rpx; margin-bottom: 24rpx; text-align: justify;
}

/* ---------- 底部 ---------- */
.more-card { padding: 26rpx 28rpx; }
.more-t { display: block; font-size: 28rpx; font-weight: 600; color: #1a2233; }
.more-d { display: block; font-size: 24rpx; color: #8c98ab; line-height: 1.7; margin-top: 8rpx; }
.more-a { display: block; font-size: 25rpx; color: #1a73e8; margin-top: 14rpx; }

.foot { text-align: center; font-size: 22rpx; color: #b6c0cf; margin: 50rpx 0 20rpx; }
