.container { padding-bottom: 40rpx; }
.hint { font-size: 24rpx; color: #8a97a8; line-height: 1.6; margin: 24rpx 32rpx 4rpx; }

.card { background: #fff; border-radius: 20rpx; margin: 20rpx 24rpx; padding: 28rpx 32rpx; box-shadow: 0 4rpx 18rpx rgba(0,0,0,.03); }
.sec-title { font-size: 28rpx; font-weight: 600; color: #222; margin-bottom: 16rpx; }

.prov { display: flex; align-items: center; padding: 22rpx 0; border-bottom: 1rpx solid #f2f4f8; }
.prov:last-child { border-bottom: none; }
.prov-main { flex: 1; }
.prov-name { display: block; font-size: 30rpx; color: #24324a; }
.prov.on .prov-name { color: #1a73e8; font-weight: 600; }
.prov-note { display: block; font-size: 22rpx; color: #9aa6b5; margin-top: 6rpx; }
.radio { width: 36rpx; height: 36rpx; border-radius: 50%; border: 2rpx solid #c6d0de; box-sizing: border-box;
  display: flex; align-items: center; justify-content: center; font-size: 22rpx; color: #fff; }
.radio.checked { background: #1a73e8; border-color: #1a73e8; }

.picker { background: #f0f1f3; border-radius: 10rpx; padding: 20rpx 24rpx; font-size: 28rpx; color: #333; }

/* 拉取最新型号 / 手填型号 */
.sec-row { display: flex; align-items: center; justify-content: space-between; margin: 28rpx 0 16rpx; }
.fetch-btn { font-size: 23rpx; color: #1a73e8; border: 1rpx solid #cfe0fb; border-radius: 30rpx; padding: 6rpx 20rpx; }
.fetch-btn:active { background: #eaf1fe; }
.fetch-msg {
  font-size: 22rpx; color: #b42318; background: #fff2f2; border-radius: 10rpx;
  padding: 12rpx 16rpx; margin-top: 14rpx; line-height: 1.6;
}
.fetch-msg.ok { color: #0f5132; background: #e7f7ef; }
.f-input.custom { margin-top: 14rpx; font-size: 25rpx; }

/* 说明：选模型不需要 Key，只有拉取才需要 */
.model-hint { font-size: 22rpx; color: #9aa6b5; line-height: 1.7; margin-top: 12rpx; }
.model-acts { display: flex; margin-top: 14rpx; }
.f-input { background: #f0f1f3; border-radius: 10rpx; padding: 20rpx 24rpx; font-size: 28rpx; }
.key-url { font-size: 22rpx; color: #1a73e8; margin-top: 14rpx; }

.btns { margin: 30rpx 24rpx; }
.btn-primary { background: #1a73e8; color: #fff; border-radius: 48rpx; font-size: 31rpx; line-height: 92rpx; }
.btn-ghost { background: #fff; color: #5a6b82; border: 1rpx solid #d7dee9; border-radius: 48rpx; font-size: 29rpx; line-height: 88rpx; margin-top: 20rpx; }
.foot { text-align: center; font-size: 22rpx; color: #b6c0cf; margin-top: 20rpx; }

/* 顶部分段切换：对话模型 / 识图模型 */
.tabs { display: flex; margin: 24rpx 24rpx 0; background: #eaeef5; border-radius: 14rpx; padding: 6rpx; }
.tab {
  flex: 1; text-align: center; font-size: 27rpx; color: #5a6684;
  line-height: 64rpx; border-radius: 10rpx;
}
.tab.on { background: #fff; color: #1a73e8; font-weight: 600; box-shadow: 0 2rpx 8rpx rgba(24,39,75,.06); }

/* 识图推荐卡 */
.tip-card { background: #eef4ff; border-radius: 16rpx; margin: 16rpx 24rpx 0; padding: 22rpx 26rpx; }
.tip-t { display: block; font-size: 26rpx; font-weight: 600; color: #1a4fbf; }
.tip-d { display: block; font-size: 23rpx; color: #5a7bb5; line-height: 1.7; margin-top: 8rpx; }
.tip-a { display: block; font-size: 22rpx; color: #1a73e8; margin-top: 12rpx; word-break: break-all; }

/* ---------- 页内使用说明 ---------- */
.guide { background: #fff; border-radius: 20rpx; margin: 24rpx 24rpx 0; box-shadow: 0 4rpx 18rpx rgba(0,0,0,.03); overflow: hidden; }
.guide-head { display: flex; align-items: center; padding: 26rpx 28rpx; }
.guide-t { flex: 1; font-size: 28rpx; font-weight: 600; color: #1a2233; }
.guide-arrow { font-size: 32rpx; color: #c6d0de; line-height: 1; transition: transform .2s; }
.guide-arrow.up { transform: rotate(180deg); }

.guide-body { padding: 0 28rpx 28rpx; border-top: 1rpx solid #f2f4f8; }
.gq { font-size: 25rpx; color: #5a6684; line-height: 1.75; margin-top: 22rpx; }

.gs { display: flex; margin-top: 24rpx; }
.gs-no {
  width: 36rpx; height: 36rpx; flex-shrink: 0; margin-right: 16rpx; margin-top: 2rpx;
  font-size: 22rpx; color: #fff; background: #1a73e8; border-radius: 50%;
  text-align: center; line-height: 36rpx;
}
.gs-c { flex: 1; min-width: 0; }
.gs-t { display: block; font-size: 27rpx; font-weight: 600; color: #1a2233; }
.gs-d { display: block; font-size: 24rpx; color: #6a7689; line-height: 1.75; margin-top: 6rpx; }

.gnote {
  font-size: 23rpx; color: #6b5b1f; background: #fff8e6; border-radius: 12rpx;
  padding: 16rpx 20rpx; line-height: 1.75; margin-top: 26rpx;
}

.gsub { font-size: 25rpx; font-weight: 600; color: #1a2233; margin: 30rpx 0 4rpx; }
.gli { padding: 16rpx 0; border-bottom: 1rpx solid #f2f4f8; }
.gli:last-child { border-bottom: none; }
.gli-t { display: block; font-size: 26rpx; color: #1a2233; }
.gli-d { display: block; font-size: 23rpx; color: #7c8a9e; line-height: 1.7; margin-top: 6rpx; }

.gfaq { padding: 16rpx 0; border-bottom: 1rpx solid #f2f4f8; }
.gfaq:last-child { border-bottom: none; }
.gfaq-q { display: block; font-size: 26rpx; color: #1a2233; }
.gfaq-a { display: block; font-size: 23rpx; color: #7c8a9e; line-height: 1.7; margin-top: 6rpx; }
