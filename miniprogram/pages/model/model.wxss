.container { padding-bottom: 40rpx; }
.hint { font-size: 24rpx; color: #8a97a8; line-height: 1.6; margin: 24rpx 32rpx 4rpx; }

.card { background: #fff; border-radius: 20rpx; margin: 20rpx 24rpx; padding: 28rpx 32rpx; box-shadow: 0 4rpx 18rpx rgba(0,0,0,.03); }
.sec-title { font-size: 28rpx; font-weight: 600; color: #222; margin-bottom: 16rpx; }

.prov { display: flex; align-items: center; padding: 22rpx 0; border-bottom: 1rpx solid #f2f4f8; }
.prov:last-child { border-bottom: none; }
.prov-main { flex: 1; }
.prov-name { display: block; font-size: 30rpx; color: #24324a; }
.prov.on .prov-name { color: #1a73e8; font-weight: 600; }
.prov-note { display: block; font-size: 22rpx; color: #9aa6b5; margin-top: 6rpx; }
.radio { width: 36rpx; height: 36rpx; border-radius: 50%; border: 2rpx solid #c6d0de; box-sizing: border-box;
  display: flex; align-items: center; justify-content: center; font-size: 22rpx; color: #fff; }
.radio.checked { background: #1a73e8; border-color: #1a73e8; }

.picker { background: #f0f1f3; border-radius: 10rpx; padding: 20rpx 24rpx; font-size: 28rpx; color: #333; }
.f-input { background: #f0f1f3; border-radius: 10rpx; padding: 20rpx 24rpx; font-size: 28rpx; }
.key-url { font-size: 22rpx; color: #1a73e8; margin-top: 14rpx; }

.btns { margin: 30rpx 24rpx; }
.btn-primary { background: #1a73e8; color: #fff; border-radius: 48rpx; font-size: 31rpx; line-height: 92rpx; }
.btn-ghost { background: #fff; color: #5a6b82; border: 1rpx solid #d7dee9; border-radius: 48rpx; font-size: 29rpx; line-height: 88rpx; margin-top: 20rpx; }
.foot { text-align: center; font-size: 22rpx; color: #b6c0cf; margin-top: 20rpx; }

/* 顶部分段切换：对话模型 / 识图模型 */
.tabs { display: flex; margin: 24rpx 24rpx 0; background: #eaeef5; border-radius: 14rpx; padding: 6rpx; }
.tab {
  flex: 1; text-align: center; font-size: 27rpx; color: #5a6684;
  line-height: 64rpx; border-radius: 10rpx;
}
.tab.on { background: #fff; color: #1a73e8; font-weight: 600; box-shadow: 0 2rpx 8rpx rgba(24,39,75,.06); }

/* 识图推荐卡 */
.tip-card { background: #eef4ff; border-radius: 16rpx; margin: 16rpx 24rpx 0; padding: 22rpx 26rpx; }
.tip-t { display: block; font-size: 26rpx; font-weight: 600; color: #1a4fbf; }
.tip-d { display: block; font-size: 23rpx; color: #5a7bb5; line-height: 1.7; margin-top: 8rpx; }
.tip-a { display: block; font-size: 22rpx; color: #1a73e8; margin-top: 12rpx; word-break: break-all; }
